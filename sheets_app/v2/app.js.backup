      <div class="modal-content" style="border-radius: 20px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
        <div class="modal-header bg-primary text-white" style="border-radius: 20px 20px 0 0; padding: 1.2rem 1.5rem;">
          <h5 class="modal-title fw-bold m-0"><i class="bi bi-person-plus-fill me-2"></i>?좉퇋 ?숈깮 ?깅줉</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4 bg-light">
          <div class="mb-3">
            <label class="form-label fw-bold text-dark small">?숈깮 ?대쫫 <span class="text-danger">*</span></label>
            <input type="text" id="newStuName" class="form-control form-control-lg border-0 shadow-sm" placeholder="?? ?띻만??>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-6">
              <label class="form-label fw-bold text-dark small">?숆탳</label>
              <input type="text" id="newStuSchool" class="form-control border-0 shadow-sm" placeholder="?? ?섏셿?섎굹以?>
            </div>
            <div class="col-6">
              <label class="form-label fw-bold text-dark small">?숇뀈</label>
              <select id="newStuGrade" class="form-select border-0 shadow-sm">
                <option value="">?좏깮</option>
                <option value="珥?">珥?</option><option value="珥?">珥?</option><option value="珥?">珥?</option>
                <option value="珥?">珥?</option><option value="珥?">珥?</option><option value="珥?">珥?</option>
                <option value="以?">以?</option><option value="以?">以?</option><option value="以?">以?</option>
                <option value="怨?">怨?</option><option value="怨?">怨?</option><option value="怨?">怨?</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold text-dark small">?숈깮 ?곕씫泥?/label>
            <input type="tel" id="newStuPhone" class="form-control border-0 shadow-sm" placeholder="010-0000-0000">
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold text-dark small">?숇?紐??곕씫泥?<span class="text-danger">*</span></label>
            <input type="tel" id="newStuParentPhone" class="form-control border-0 shadow-sm" placeholder="010-0000-0000">
          </div>
        </div>
        <div class="modal-footer border-0 p-3 bg-white" style="border-radius: 0 0 20px 20px;">
          <button type="button" class="btn btn-light fw-bold w-100 mb-2 rounded-pill" data-bs-dismiss="modal">痍⑥냼</button>
          <button type="button" class="btn btn-primary fw-bold w-100 m-0 py-2 rounded-pill shadow-sm" onclick="saveNewStudent()">?깅줉 ?꾨즺</button>
        </div>
      </div>
    </div>
  </div>`;

  document.body.insertAdjacentHTML('beforeend', modalHtml);
  const modal = new bootstrap.Modal(document.getElementById('newStudentModal'));
  modal.show();
};

