window.openTemplateBuilder = function (tIdx = null) {
  let tbIdxInput = document.getElementById('tb-idx');
  if (!tbIdxInput) {
    tbIdxInput = document.createElement('input');
    tbIdxInput.type = 'hidden';
    tbIdxInput.id = 'tb-idx';
    document.getElementById('templateBuilderModal').appendChild(tbIdxInput);
  }

  const saveBtn = document.getElementById('btn-save-template');

  if (tIdx !== null && appCache.templates[tIdx]) {
    document.getElementById('tb-title').value = appCache.templates[tIdx].title;
    document.getElementById('tb-content').value = appCache.templates[tIdx].content;
    tbIdxInput.value = tIdx;
    if (saveBtn) saveBtn.innerText = '?섏젙?섍린';
  } else {
    document.getElementById('tb-title').value = '';
    document.getElementById('tb-content').value = '?덈뀞?섏꽭?? ?섑븰?????뮋{?숈깮?대쫫} ?댁엫 {媛뺤궗?대쫫}?낅땲???Ⅰ\n\n';
    tbIdxInput.value = '';
    if (saveBtn) saveBtn.innerText = '??ν븯湲?;
  }

  const tagContainer = document.querySelector('#templateBuilderModal .d-flex.flex-wrap.gap-1');
  if (tagContainer) {
    tagContainer.innerHTML = `
      <button class="btn btn-sm btn-outline-primary fw-bold" onclick="insertTag('{?숈깮?대쫫}')">{?숈깮?대쫫}</button>
      <button class="btn btn-sm btn-outline-primary fw-bold" onclick="insertTag('{媛뺤궗?대쫫}')">{媛뺤궗?대쫫}</button>
      <button class="btn btn-sm btn-outline-primary fw-bold" onclick="insertTag('{?좎쭨}')">{?좎쭨}</button>
      <button class="btn btn-sm btn-outline-success fw-bold" onclick="insertTag('{?ㅻ뒛吏꾨룄}')">{?ㅻ뒛吏꾨룄}</button>
      <button class="btn btn-sm btn-outline-success fw-bold" onclick="insertTag('{?ㅼ쓬怨쇱젣}')">{?ㅼ쓬怨쇱젣}</button>
      <button class="btn btn-sm btn-outline-danger fw-bold" onclick="insertTag('{?뚯뒪?몄쥌瑜?')">{?뚯뒪?몄쥌瑜?</button>
      <button class="btn btn-sm btn-outline-danger fw-bold" onclick="insertTag('{留욎?媛쒖닔}')">{留욎?媛쒖닔}</button>
      <button class="btn btn-sm btn-outline-danger fw-bold" onclick="insertTag('{?꾩껜媛쒖닔}')">{?꾩껜媛쒖닔}</button>
      <button class="btn btn-sm btn-outline-danger fw-bold" onclick="insertTag('{?뚯뒪?명뵾?쒕갚}')">{?뚯뒪?명뵾?쒕갚}</button>
      <button class="btn btn-sm btn-outline-secondary fw-bold" onclick="insertTag('{媛쒕퀎?숈뒿}')">{媛쒕퀎?숈뒿}</button>
      <button class="btn btn-sm btn-outline-secondary fw-bold" onclick="insertTag('{怨쇱젣?쇰뱶諛?')">{怨쇱젣?쇰뱶諛?</button>
      <button class="btn btn-sm btn-outline-secondary fw-bold" onclick="insertTag('{醫낇빀?덈궡}')">{醫낇빀?덈궡}</button>
      <button class="btn btn-sm btn-outline-secondary fw-bold" onclick="insertTag('{?덇탳??')">{?덇탳??</button>
      <button class="btn btn-sm btn-outline-warning fw-bold" onclick="insertTag('{移?갔}')">{移?갔}</button>
      <button class="btn btn-sm btn-outline-warning fw-bold" onclick="insertTag('{?몃젰}')">{?몃젰}</button>
      <button class="btn btn-sm btn-outline-info fw-bold" onclick="insertTag('{遺紐⑤떂猿?')">{遺紐⑤떂猿?</button>
      <button class="btn btn-sm btn-outline-info fw-bold" onclick="insertTag('{?됱궗?덈궡}')">{?됱궗?덈궡}</button>
    `;
  }

  let modalEl = document.getElementById('templateBuilderModal');
