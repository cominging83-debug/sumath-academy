// ?뱴 援먯옱 吏꾨룄 愿由?(v2 ?좉퇋 湲곕뒫)
// =========================================

window.getTotalPages = function(bookName) {
  if (!bookName || !appCache.raw || !appCache.raw.books) return 0;
  const book = appCache.raw.books.find(b => b[0] === bookName);
  if (!book) return 0;
  const pages = parseInt(book[3], 10);
  return isNaN(pages) ? 0 : pages;
};

window.getStudentBookProgress = function(studentId) {
  const progressMap = {};
  if (!appCache.raw || !appCache.raw.attendance) return progressMap;

  appCache.raw.attendance.forEach(r => {
    if (r[1] !== studentId) return;
    const bookName = r[9];
    const range = r[10];
    if (!bookName || !range) return;

    const nums = range.match(/\d+/g);
    if (!nums || nums.length === 0) return;

    const maxPage = Math.max(...nums.map(Number));
    const totalPages = getTotalPages(bookName);

    if (!progressMap[bookName]) {
      progressMap[bookName] = {
        current: 0,
        total: totalPages,
        lastDate: '',
        progressPercent: 0
      };
    }

    if (maxPage > progressMap[bookName].current) {
      progressMap[bookName].current = maxPage;
      progressMap[bookName].progressPercent = totalPages > 0
        ? Math.round((maxPage / totalPages) * 100)
        : 0;
    }

    const date = r[3] || '';
    if (date > progressMap[bookName].lastDate) {
      progressMap[bookName].lastDate = date;
    }
  });

  return progressMap;
};

window.renderBookProgressHTML = function(studentId) {
  const progress = getStudentBookProgress(studentId);
  if (Object.keys(progress).length === 0) {
    return '<p class="text-muted small">?깅줉??援먯옱 吏꾨룄媛 ?놁뒿?덈떎.</p>';
  }

  let html = '<div class="table-responsive"><table class="table table-sm align-middle">';
  html += '<thead class="table-light"><tr><th>援먯옱紐?/th><th>吏꾨룄</th><th>留덉?留??숈뒿</th></tr></thead><tbody>';

  Object.entries(progress).forEach(([bookName, data]) => {
    html += `<tr><td class="fw-bold" style="font-size: 0.9rem;">${bookName}</td>`;
    html += `<td><div class="progress" style="height: 20px;">`;
    html += `<div class="progress-bar bg-success" style="width: ${data.progressPercent}%;" role="progressbar">`;
    html += `<small class="fw-bold text-white" style="font-size: 0.7rem;">${data.progressPercent}%</small></div></div>`;
    html += `<small class="text-muted">${data.current}/${data.total}P</small></td>`;
    html += `<td class="text-muted small">${data.lastDate || '-'}</td></tr>`;
  });

  html += '</tbody></table></div>';
  return html;
};

window.getBookProgressForDashboard = function() {
  const allStudents = appCache.raw.students || [];
  const progressData = [];

  allStudents.slice(1).forEach(student => {
    const studentId = student[0];
    const studentName = student[1];
    const progress = getStudentBookProgress(studentId);

    if (Object.keys(progress).length > 0) {
      const avgProgress = Math.round(
        Object.values(progress).reduce((sum, p) => sum + p.progressPercent, 0) /
        Object.keys(progress).length
      );

      progressData.push({
        id: studentId,
        name: studentName,
        avgProgress,
        bookCount: Object.keys(progress).length
      });
    }
  });

  progressData.sort((a, b) => b.avgProgress - a.avgProgress);
  return progressData;
};

