                <input type="text" class="form-control fw-bold border-primary" id="regStudentSelect" list="regStudentList" placeholder="?대쫫???낅젰?섏꽭?? autocomplete="off">
                <datalist id="regStudentList">
                  ${(appCache.raw.students || []).slice(1).filter(s => s[1]).map(s => {
    const displayStr = s[15] || `${s[1]} (${s[4] || ''}/${s[3] || ''}) - ${s[0]}`;
