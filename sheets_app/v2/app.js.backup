window.loadScoreView = async function () {
  try {
    const role = (appCache.user.role || '').trim();
    const isManager = (role === '?먯옣' || role === '?곗뒪?? || role === '愿由ъ옄');
    const myName = (appCache.user.name || '').trim();

    if (isManager) {
      try {
        const created = await ensureScoreSheet();
        if (created) appCache.raw.scores = [];
      } catch (e) { console.warn('?깆쟻DB 泥댄겕 嫄대꼫?:', e.message); }
    }

    const scores = (appCache.raw && appCache.raw.scores) || [];
    const sorted = [...scores].reverse();

    let tableRows = '';
    if (sorted.length === 0) tableRows = `<tr><td colspan="8" class="text-center py-5 text-muted">?깅줉???깆쟻 ?곗씠?곌? ?놁뒿?덈떎.</td></tr>`;
    else {
      const filtered = isManager ? sorted : sorted.filter(r => (r[9] || '').includes(myName));
      filtered.forEach(r => {
        const date = (r[3] || '').substring(0, 10); const student = r[2] || '-'; const examType = r[4] || '-'; const subject = r[5] || '-'; const score = r[6] !== undefined && r[6] !== '' ? r[6] : '-'; const total = r[7] || '100'; const memo = r[8] || ''; const teacher = r[9] || '-';
        const pct = (score !== '-' && total) ? Math.round(parseFloat(score) / parseFloat(total) * 100) : null;
        const pctColor = pct === null ? '' : pct >= 90 ? 'text-success' : pct >= 70 ? 'text-primary' : pct >= 50 ? 'text-warning' : 'text-danger';
        let typeBadge = 'bg-secondary'; if (examType.includes('以묎컙')) typeBadge = 'bg-danger'; else if (examType.includes('?⑥썝')) typeBadge = 'bg-primary'; else if (examType.includes('?붾쭚')) typeBadge = 'bg-info text-white';
        tableRows += `<tr style="font-size:0.83rem;"><td class="text-muted fw-bold">${date}</td><td class="fw-bold">${student}</td><td><span class="badge ${typeBadge} rounded-pill">${examType}</span></td><td>${subject}</td><td class="fw-bold fs-6 text-center">${score}</td><td class="text-center text-muted">/ ${total}</td><td class="fw-bold ${pctColor} text-center">${pct !== null ? pct + '%' : '-'}</td><td class="text-muted small">${memo || (isManager ? teacher : '')}</td></tr>`;
      });
      if (!tableRows) tableRows = `<tr><td colspan="8" class="text-center py-5 text-muted">?대떦 沅뚰븳??留욌뒗 ?깆쟻 ?곗씠?곌? ?놁뒿?덈떎.</td></tr>`;
    }

    document.getElementById('view-container').innerHTML = `
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold m-0"><i class="bi bi-bar-chart-fill me-2 text-success"></i>?깆쟻 愿由?/h4>
        <div class="d-flex gap-2">
          <input type="text" id="scoreSearchInput" class="form-control form-control-sm border-success rounded-pill px-3 shadow-sm" placeholder="?뵇 ?숈깮紐?寃??.." style="width: 150px;" onkeyup="filterTableRows('scoreSearchInput', 'scoreTable', 1)">
          <button class="btn btn-outline-secondary btn-sm rounded-pill text-nowrap" onclick="refreshScoreData()"><i class="bi bi-arrow-clockwise"></i></button>
          <button class="btn btn-success btn-sm rounded-pill fw-bold text-nowrap" onclick="openScoreModal()"><i class="bi bi-plus-lg"></i> ?낅젰</button>
        </div>
      </div>
      <div class="card shadow-sm border-0">
        <div class="table-responsive" style="max-height:65vh;">
          <table class="table table-hover align-middle mb-0" id="scoreTable">
            <thead class="table-light sticky-top"><tr style="font-size:0.82rem;"><th>?쒗뿕??/th><th>?숈깮紐?/th><th>?쒗뿕醫낅쪟</th><th>怨쇰ぉ</th><th class="text-center">?먯닔</th><th class="text-center">留뚯젏</th><th class="text-center">?깆랬??/th><th>${isManager ? '媛뺤궗' : '鍮꾧퀬'}</th></tr></thead>
            <tbody>${tableRows}</tbody>
          </table>
        </div>
      </div>`;
  } catch (e) {
    document.getElementById('view-container').innerHTML = `<div class="alert alert-danger m-4">?깆쟻 愿由?濡쒕뵫 ?ㅻ쪟: ${e.message}</div>`;
  }
};

window.openScoreModal = function () {
  let existing = document.getElementById('scoreModal');
  if (existing) existing.remove();

  let studentOptions = '';
  if (appCache.raw && appCache.raw.students) {
    let sorted = [];
    for (let i = 1; i < appCache.raw.students.length; i++) {
      if (appCache.raw.students[i][0]) sorted.push({ id: appCache.raw.students[i][0], name: appCache.raw.students[i][1], school: appCache.raw.students[i][3] });
    }
    sorted.sort((a, b) => a.name.localeCompare(b.name)).forEach(s => {
      studentOptions += `<option value="${s.name} (${s.school})" data-id="${s.id}">`;
    });
  }

  const modalHtml = `
  <div class="modal fade" id="scoreModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg">
        <div class="modal-header bg-success text-white">
          <h5 class="modal-title fw-bold"><i class="bi bi-plus-lg"></i> ?깆쟻 ?낅젰</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4 bg-light">
          <div class="mb-3">
            <label class="form-label fw-bold small text-muted">?숈깮 寃??<span class="text-danger">*</span></label>
            <input type="text" id="score-student-search" class="form-control fw-bold border-success" list="scoreStudentList" placeholder="?대쫫 ?낅젰 ???좏깮" onchange="document.getElementById('score-student-id').value = this.list.querySelector('option[value=\\''+this.value+'\\']')?.dataset.id || ''">
            <datalist id="scoreStudentList">${studentOptions}</datalist>
            <input type="hidden" id="score-student-id">
          </div>
          <div class="row g-3 mb-3">
            <div class="col-6">
              <label class="form-label fw-bold small text-muted">?쒗뿕 ?쇱옄 <span class="text-danger">*</span></label>
              <input type="date" id="score-date" class="form-control" value="${new Date().toISOString().substring(0, 10)}">
            </div>
            <div class="col-6">
              <label class="form-label fw-bold small text-muted">?쒗뿕 醫낅쪟</label>
              <select id="score-type" class="form-select">
                <option value="?⑥썝?됯?">?⑥썝?됯?</option>
                <option value="?붾쭚?됯?">?붾쭚?됯?</option>
                <option value="以묎컙怨좎궗">以묎컙怨좎궗</option>
                <option value="湲곕쭚怨좎궗">湲곕쭚怨좎궗</option>
                <option value="紐⑥쓽怨좎궗">紐⑥쓽怨좎궗</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label fw-bold small text-muted">怨쇰ぉ</label>
              <input type="text" id="score-subject" class="form-control" value="?섑븰">
            </div>
            <div class="col-6">
              <label class="form-label fw-bold small text-muted">?띾뱷 ?먯닔 <span class="text-danger">*</span></label>
              <input type="number" id="score-score" class="form-control fw-bold text-primary" placeholder="?? 95">
            </div>
            <div class="col-6">
              <label class="form-label fw-bold small text-muted">留뚯젏 湲곗?</label>
              <input type="number" id="score-total" class="form-control" value="100">
            </div>
            <div class="col-12">
              <label class="form-label fw-bold small text-muted">鍮꾧퀬 (肄붾찘??</label>
