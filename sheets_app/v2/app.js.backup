          <button class="btn btn-success rounded-pill fw-bold px-4 shadow-sm" onclick="saveScore()"><i class="bi bi-check-circle-fill me-1"></i> ??ν븯湲?/button>
        </div>
      </div>
    </div>
  </div>`;
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  new bootstrap.Modal(document.getElementById('scoreModal')).show();
};
