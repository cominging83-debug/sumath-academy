// =========================================
// ?곗씠???뚯떛 (Raw -> ???꾩슜 JSON)
// =========================================
function parseRawData() {
  const { schedules, students, attendance } = appCache.raw;

  // 1. ?ㅻ뒛 ?좎쭨 (?대씪?댁뼵??湲곗?)
  const today = new Date().toISOString().substring(0, 10);

  // 2. ?숈깮 ?곗씠???뚯떛 (?먯쿇DB)
  const studentMap = {};
  for (let i = 1; i < students.length; i++) {
    const r = students[i];
    studentMap[r[0]] = {
      id: r[0], name: r[1], dept: r[2], school: r[3], grade: r[4],
      status: r[7], regDate: r[8]
    };
  }

  // 3. ?ㅻ뒛 ?쒓컙???뚯떛 (?섍컯?쇱젙DB)
  const dayOfWeek = ['??, '??, '??, '??, '紐?, '湲?, '??][new Date().getDay()];
  let todaysClasses = [];

  for (let i = 1; i < schedules.length; i++) {
    const r = schedules[i];
    // ?붿씪 泥댄겕
    if (r[4] !== dayOfWeek) continue;

    // 媛뺤궗 泥댄겕 (媛뺤궗 沅뚰븳?대㈃ 蹂몄씤 ?섏뾽留?
    if (appCache.user.role === '媛뺤궗' && r[3] !== appCache.user.name) continue;

    // ?숈깮 ?곹깭媛 '?ъ썝'?몄? ?뺤씤
    const sId = r[0].replace(/[^a-zA-Z0-9]/g, ''); // 愿꾪샇 ???쒓굅?섍퀬 ID留?異붿텧 (媛쒖꽑 ?꾩슂)
    let sLevel = "蹂닿컯", sName = r[0]; // ?쒖떆紐??ъ슜

    todaysClasses.push({
      id: `evt_${i}`,
      timeStr: r[6], // ?쒖옉?쒓컙
      day: r[4],
      teacherId: r[3],
      room: r[11] || r[2], // 媛뺤쓽??
      statusLevel: 0, // 湲곕낯 誘몄엯??
      students: [{ id: sId, badge: sName, level: sLevel }]
    });
  }

  // 4. 異쒓껐 泥댄겕 ?곹깭 諛섏쁺
  const todayAtt = attendance.filter(r => r[3] && String(r[3]).substring(0, 10) === today);

  // ?곹깭 怨꾩궛 (?꾩떆: 0: ?湲? 1: ?꾩떆, 2: ?꾨즺)
  // 異뷀썑 怨좊룄???꾩슂

  appCache.schedule = {
    today: today,
    events: todaysClasses
  };

  // ?? [?뚯뒪??紐⑤뱶] ?곗씠??濡쒕뵫 ?꾨즺 吏곹썑 怨꾩젙 ?ㅼ쐞移??꾩젽 ?ㅽ뻾
  if (typeof createTestLoginWidget === 'function') {
    createTestLoginWidget();
  }
}

// =================================================================
// ?뮕 [?대┃ ?쇰뱶諛??좊땲硫붿씠?? 踰꾪듉 ?꾨Ⅴ硫???곸씠 轅?? ?섎㈃???뚮옑寃?鍮쏅궔?덈떎!
// =================================================================
window.highlightSection = function (id) {
  const el = document.getElementById(id);
  if (el) {
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.style.transition = 'all 0.3s ease';
    el.style.transform = 'scale(1.02)';
    el.style.boxShadow = '0 0 20px rgba(13, 202, 240, 0.8)';
    el.style.zIndex = '10';
    el.style.position = 'relative';
    setTimeout(() => {
      el.style.transform = 'scale(1)';
      el.style.boxShadow = 'none';
      el.style.zIndex = '1';
    }, 500);
  }
};

