// 1. ?쒓컙??蹂寃?紐⑤떖 ?닿린
window.openScheduleChangeModal = function (studentId, studentName) {
  const schedules = appCache.raw.schedules || [];
  // ?대떦 ?숈깮??'?쒖꽦' ?곹깭???쒓컙?쒕쭔 ?꾪꽣留?
  const activeSchedules = schedules.filter(r =>
    ((r[0] || '').includes(studentId) || (r[0] || '').includes(studentName)) && (r[14] || '').trim() !== '鍮꾪솢??
  );

  const teachers = (appCache.raw.teachers || []).filter(t => t[1] && t[4] !== '?댁궗').map(t => t[1]);
  let teacherOptions = teachers.map(t => `<option value="${t}">${t}</option>`).join('');

  let listHtml = activeSchedules.map((s, idx) => `
    <div class="card border-0 shadow-sm mb-2 bg-light">
      <div class="card-body p-3 d-flex justify-content-between align-items-center">
        <div>
          <span class="badge bg-primary me-2">${s[4]}?붿씪</span>
          <strong class="text-dark">${s[6]} ~ ${s[7]}</strong>
          <div class="small text-muted mt-1">?대떦: ${s[9]}T | 媛뺤쓽?? ${s[11] || '-'}</div>
        </div>
        <button class="btn btn-sm btn-outline-danger fw-bold rounded-pill" onclick="deactivateSchedule('${studentId}', '${studentName}', '${s[4]}', '${s[6]}')">?섏뾽 醫낅즺</button>
      </div>
    </div>
  `).join('');

  if (activeSchedules.length === 0) listHtml = '<div class="text-center py-4 text-muted small">?꾩옱 ?섍컯 以묒씤 ?뺢퇋 ?섏뾽???놁뒿?덈떎.</div>';

  const modalHtml = `
    <div class="modal fade" id="scheduleManageModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
          <div class="modal-header bg-dark text-white">
            <h5 class="modal-title fw-bold"><i class="bi bi-calendar-range me-2"></i>?쒓컙??蹂寃?愿由?/h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-list-check me-2 text-primary"></i>?꾩옱 ?섍컯 以묒씤 ?섏뾽</h6>
            <div class="mb-4" style="max-height: 200px; overflow-y: auto;">${listHtml}</div>
            
            <hr class="my-4">
            
            <h6 class="fw-bold mb-3 text-success"><i class="bi bi-plus-circle-fill me-2"></i>?덈줈???섏뾽 異붽?</h6>
            <div class="row g-2">
              <div class="col-4">
                <select id="sm-day" class="form-select form-select-sm"><option value="??>?붿슂??/option><option value="??>?붿슂??/option><option value="??>?섏슂??/option><option value="紐?>紐⑹슂??/option><option value="湲?>湲덉슂??/option><option value="??>?좎슂??/option><option value="??>?쇱슂??/option></select>
              </div>
              <div class="col-8">
                <select id="sm-teacher" class="form-select form-select-sm">${teacherOptions}</select>
              </div>
              <div class="col-6">
                <div class="input-group input-group-sm"><span class="input-group-text">?쒖옉</span><input type="time" id="sm-start" class="form-control" value="17:00"></div>
              </div>
              <div class="col-6">
                <div class="input-group input-group-sm"><span class="input-group-text">醫낅즺</span><input type="time" id="sm-end" class="form-control" value="19:00"></div>
              </div>
              <div class="col-12 mt-2">
                <input type="text" id="sm-room" class="form-control form-control-sm" placeholder="媛뺤쓽??(?? 蹂멸?-R1)">
              </div>
              <div class="col-12 mt-3">
                <button class="btn btn-success btn-sm w-100 fw-bold rounded-pill" onclick="addNewScheduleRow('${studentId}', '${studentName}')">???섏뾽 ?깅줉?섍린</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>`;

  const existing = document.getElementById('scheduleManageModal');
  if (existing) existing.remove();
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  new bootstrap.Modal(document.getElementById('scheduleManageModal')).show();
};

// 2. ?섏뾽 醫낅즺(鍮꾪솢?깊솕) 泥섎━
window.deactivateSchedule = async function (studentId, studentName, day, startTime) {
  if (!confirm(`[${day}?붿씪 ${startTime}] ?섏뾽??醫낅즺 泥섎━?섏떆寃좎뒿?덇퉴?\n?댄썑?먮뒗 '?섍컯 蹂???대젰'?먯꽌留??뺤씤 媛?ν빀?덈떎.`)) return;

  showLoader(true, "?섏뾽 ?뺣낫瑜??낅뜲?댄듃 以?..");
  try {
    const sheetName = CONFIG.SHEETS.SCHEDULE;
    const res = await callSheetsAPI('GET', `/values/${encodeURIComponent(sheetName)}!A:O`);
    const rows = res.values || [];

    // ?뺥솗????李얘린 (?대쫫/ID + ?붿씪 + ?쒖옉?쒓컙 留ㅼ묶)
    const rowIndex = rows.findIndex(r =>
      ((r[0] || '').includes(studentId) || (r[0] || '').includes(studentName)) &&
      r[4] === day && r[6] === startTime && (r[14] || '').trim() !== '鍮꾪솢??
    );

    if (rowIndex < 0) throw new Error("?대떦 ?섏뾽 ?곗씠?곕? 李얠쓣 ???놁뒿?덈떎.");

    const rowNum = rowIndex + 1;
    await callSheetsAPI('PUT', `/values/${encodeURIComponent(sheetName + '!O' + rowNum)}?valueInputOption=USER_ENTERED`, { values: [["鍮꾪솢??]] });

    alert("?섏뾽???깃났?곸쑝濡?醫낅즺?섏뿀?듬땲??");
    bootstrap.Modal.getInstance(document.getElementById('scheduleManageModal')).hide();
    forceRefresh();
  } catch (e) {
    alert("?ㅻ쪟 諛쒖깮: " + e.message);
  } finally {
    showLoader(false);
  }
};

// 3. ???섏뾽 ??異붽?
window.addNewScheduleRow = async function (studentId, studentName) {
  const day = document.getElementById('sm-day').value;
  const teacher = document.getElementById('sm-teacher').value;
  const start = document.getElementById('sm-start').value;
  const end = document.getElementById('sm-end').value;
  const room = document.getElementById('sm-room').value;

  if (!room) return alert("媛뺤쓽?ㅼ쓣 ?낅젰?댁＜?몄슂.");

  showLoader(true, "???쒓컙???깅줉 以?..");
  try {
    const today = new Date().toISOString().substring(0, 10);
    // ?섍컯?쇱젙DB 而щ읆: A:?쒖떆紐? B:?깅줉ID, C:諛쁈D, D:?숈깮ID, E:?붿씪, F:援щ텇, G:?쒖옉, H:醫낅즺, I:援먯옱, J:媛뺤궗, K:?뚯감, L:媛뺤쓽?? M:硫붾え, N:?먮룞紐낆묶, O:?곹깭, P:?쒖옉??
    const displayLabel = `${studentName} - ${studentId}`;
    const rowData = [displayLabel, "", "", studentId, day, "?뺢퇋", start, end, "", teacher, "", room, "", "", "?쒖꽦", today];

    await callSheetsAPI('POST', `/values/${encodeURIComponent(CONFIG.SHEETS.SCHEDULE)}:append?valueInputOption=USER_ENTERED`, { values: [rowData] });

    alert("???섏뾽???깅줉?섏뿀?듬땲?? ?뱟");
    bootstrap.Modal.getInstance(document.getElementById('scheduleManageModal')).hide();
    forceRefresh();
  } catch (e) {
    alert("?깅줉 ?ㅽ뙣: " + e.message);
  } finally {
    showLoader(false);
  }
};
