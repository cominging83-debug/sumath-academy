// ?먯옣???꾩슜 ??쒕낫??(?좎쭨蹂? 洹몃９蹂??뺣━)
// =========================================
window.loadDashboardView_Manager = function() {
  const today = new Date();
  const todayStr = today.toISOString().substring(0, 10);

  // 1截뤴깵 寃곗꽍 ?숈깮 (諛섎퀎 洹몃９??
  const allAttendance = (appCache.raw.attendance || []).slice(1);
  const students = window.getActiveStudents(); // ?ъ썝留?
  const schedules = window.getActiveSchedules(); // ?ъ썝 ?숈깮???섍컯?쇱젙留?

  const absentByClass = {};
  students.forEach(s => {
    const todayRec = allAttendance.find(a => a[1] === s[0] && (a[3] || '').substring(0, 10) === todayStr);
    if (!todayRec) {
      const studentClasses = schedules.filter(sc => sc[0].includes(s[1]) || sc[3] === s[0]);
      const mainClass = studentClasses.length > 0 ? (studentClasses[0][2] || '誘몄젙') : '誘몄젙';
      if (!absentByClass[mainClass]) absentByClass[mainClass] = [];
      absentByClass[mainClass].push(s[1]);
    }
  });

  // 2截뤴깵 誘몄옉???쇱? (媛뺤궗蹂?洹몃９??
  const todayKor = ['??, '??, '??, '??, '紐?, '湲?, '??][today.getDay()];
  const todayClasses = schedules.filter(s => s[4] === todayKor && s[14] !== '鍮꾪솢??);
  const todayRecords = allAttendance.filter(a => (a[3] || '').substring(0, 10) === todayStr);

  const unwrittenByTeacher = {};
  todayClasses.forEach(cls => {
    const studentName = (cls[0] || '').split('(')[0].trim();
    const hasRecord = todayRecords.some(r => (r[2] === studentName || r[1] === cls[3]) && r[18] === '理쒖쥌');
    if (!hasRecord) {
      const teacher = cls[9] || '-';
      if (!unwrittenByTeacher[teacher]) unwrittenByTeacher[teacher] = [];
      unwrittenByTeacher[teacher].push({
        time: cls[6] + '~' + cls[7],
        className: cls[2],
        student: studentName
      });
    }
  });

  // 3截뤴깵 誘명솗??怨듭? (?곹깭蹂?
  const notices = (appCache.raw.notices || []).slice(1)
    .filter(n => n[3] !== '??젣')
    .sort((a, b) => (b[0] || '').localeCompare(a[0] || ''))
    .map(n => ({
      date: (n[0] || '').substring(0, 10),
      title: n[1] || '-',
      status: n[3] || '?湲?
    }));

  const noticesByStatus = { '?꾨즺': [], '?湲?: [] };
  notices.forEach(n => {
    if (noticesByStatus[n.status]) noticesByStatus[n.status].push(n);
  });

  let html = `
    <div class="sticky-top pt-3 pb-2" style="background: rgba(248, 249, 250, 0.95); z-index: 1020; margin-top: -1rem;">
      <h4 class="fw-bold m-0 text-dark mb-3">?럳 ${appCache.user.name} ?먯옣??- ${todayStr}</h4>
      <div class="row g-2 mb-3">
        <div class="col-md-4">
          <div class="card border-0 shadow-sm" style="border-radius: 10px; background: linear-gradient(135deg, #fee2e2, #fecaca); border-left: 4px solid #dc2626;">
            <div class="card-body p-3">
              <h6 class="text-danger fw-bold mb-1"><i class="bi bi-exclamation-circle"></i> 寃곗꽍: ${Object.values(absentByClass).flat().length}</h6>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm" style="border-radius: 10px; background: linear-gradient(135deg, #fed7aa, #fdba74); border-left: 4px solid #f97316;">
            <div class="card-body p-3">
              <h6 class="fw-bold mb-1" style="color: #b45309;"><i class="bi bi-pencil-square"></i> 誘몄옉?? ${Object.values(unwrittenByTeacher).flat().length}</h6>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm" style="border-radius: 10px; background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-left: 4px solid #2563eb;">
            <div class="card-body p-3">
              <h6 class="fw-bold mb-1" style="color: #1e40af;"><i class="bi bi-megaphone"></i> 誘명솗?? ${noticesByStatus['?湲?].length}</h6>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <!-- 寃곗꽍 (諛섎퀎) -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius: 10px; overflow: hidden;">
          <div class="card-header bg-danger text-white fw-bold p-3">
            <i class="bi bi-exclamation-circle me-2"></i>寃곗꽍 ?숈깮 (諛섎퀎)
          </div>
          <div class="card-body p-0" style="max-height: 500px; overflow-y: auto;">
            ${Object.keys(absentByClass).length === 0
              ? '<div class="p-4 text-center text-muted">紐⑤몢 異쒖꽍! ?럦</div>'
              : Object.entries(absentByClass).map(([className, names]) => `
                  <div class="p-3 border-bottom">
                    <h6 class="fw-bold mb-2 text-danger">${className}</h6>
                    <div class="d-flex flex-wrap gap-1">
                      ${names.map(n => `<span class="badge bg-danger bg-opacity-25 text-danger">${n}</span>`).join('')}
                    </div>
                  </div>
                `).join('')}
          </div>
        </div>
      </div>

      <!-- 誘몄옉??(媛뺤궗蹂? -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius: 10px; overflow: hidden;">
          <div class="card-header fw-bold p-3" style="background: #f97316; color: white;">
            <i class="bi bi-pencil-square me-2"></i>誘몄옉???쇱? (媛뺤궗蹂?
          </div>
          <div class="card-body p-0" style="max-height: 500px; overflow-y: auto;">
            ${Object.keys(unwrittenByTeacher).length === 0
              ? '<div class="p-4 text-center text-muted">紐⑤몢 ?꾨즺! ??/div>'
              : Object.entries(unwrittenByTeacher).map(([teacher, logs]) => `
                  <div class="p-3 border-bottom">
                    <h6 class="fw-bold mb-2" style="color: #b45309;">${teacher}</h6>
                    ${logs.map(log => `
                      <div class="small mb-2">
                        <span class="badge bg-warning text-dark">${log.time}</span>
                        <span class="text-muted">${log.className}</span>
                        <br><strong>${log.student}</strong>
                      </div>
                    `).join('')}
                  </div>
                `).join('')}
          </div>
        </div>
      </div>

      <!-- 怨듭? (?곹깭蹂? -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius: 10px; overflow: hidden;">
          <div class="card-header bg-primary text-white fw-bold p-3">
            <i class="bi bi-megaphone me-2"></i>怨듭? (?곹깭蹂?
          </div>
          <div class="card-body p-0" style="max-height: 500px; overflow-y: auto;">
            ${notices.length === 0
              ? '<div class="p-4 text-center text-muted">怨듭? ?놁쓬</div>'
              : `
                <div class="p-3 border-bottom">
                  <h6 class="fw-bold text-warning mb-2">???湲?(${noticesByStatus['?湲?].length})</h6>
                  ${noticesByStatus['?湲?].length === 0
                    ? '<small class="text-muted">?놁쓬</small>'
                    : noticesByStatus['?湲?].map(n => `
                        <div class="small mb-2">
                          <span class="badge bg-warning text-dark">${n.date}</span>
                          <strong>${n.title}</strong>
                        </div>
                      `).join('')}
                </div>
                <div class="p-3">
                  <h6 class="fw-bold text-success mb-2">???꾨즺 (${noticesByStatus['?꾨즺'].length})</h6>
                  ${noticesByStatus['?꾨즺'].length === 0
                    ? '<small class="text-muted">?놁쓬</small>'
                    : noticesByStatus['?꾨즺'].slice(0, 5).map(n => `
                        <div class="small mb-2">
                          <span class="badge bg-success">${n.date}</span>
                          <span class="text-muted">${n.title}</span>
                        </div>
                      `).join('')}
                </div>
              `}
          </div>
        </div>
      </div>
    </div>
  `;

  document.getElementById('view-container').innerHTML = html;
};

