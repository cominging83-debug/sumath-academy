function renderStudentTab_Attendance(studentId) {
  const attendance = (appCache.raw.attendance || []).slice(1).filter(a => a[1] === studentId);
  const today = new Date().toISOString().split('T')[0];
  const thisMonth = attendance.filter(a => a[3] && a[3].substring(0, 7) === today.substring(0, 7));

  const stats = {
    total: thisMonth.length,
    present: thisMonth.filter(a => a[5] === '異쒖꽍').length,
    absent: thisMonth.filter(a => a[5] === '寃곗꽍').length,
    makeup: thisMonth.filter(a => a[5] === '蹂닿컯').length
  };

  const rate = stats.total > 0 ? Math.round((stats.present / stats.total) * 100) : 0;

  return `
    <div class="tab-pane fade" id="tab-attendance">
      <div class="row g-2 mb-4">
        <div class="col-6 col-md-3">
          <div class="card border-0 bg-light text-center">
            <div class="card-body p-3">
              <div class="fs-5 fw-bold text-primary">${stats.present}</div>
              <small class="text-muted">異쒖꽍</small>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card border-0 bg-light text-center">
            <div class="card-body p-3">
              <div class="fs-5 fw-bold text-danger">${stats.absent}</div>
              <small class="text-muted">寃곗꽍</small>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card border-0 bg-light text-center">
            <div class="card-body p-3">
              <div class="fs-5 fw-bold text-warning">${stats.makeup}</div>
              <small class="text-muted">蹂닿컯</small>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card border-0 bg-light text-center">
            <div class="card-body p-3">
              <div class="fs-5 fw-bold text-success">${rate}%</div>
              <small class="text-muted">異쒖꽍瑜?/small>
            </div>
          </div>
        </div>
      </div>

      <h6 class="fw-bold mb-3">理쒓렐 異쒖꽍 湲곕줉 (${thisMonth.length}嫄?</h6>
      <div class="list-group list-group-sm">
        ${thisMonth.length > 0 ? thisMonth.map(a => `
          <div class="list-group-item small">
            <div class="d-flex justify-content-between">
              <span>${a[3]} ${a[4]}</span>
              <span class="badge ${a[5] === '異쒖꽍' ? 'bg-success' : a[5] === '寃곗꽍' ? 'bg-danger' : 'bg-warning'}">${a[5]}</span>
            </div>
          </div>
        `).join('') : '<p class="text-muted small">?대쾲??湲곕줉???놁뒿?덈떎.</p>'}
      </div>
    </div>
  `;
}

