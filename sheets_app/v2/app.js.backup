// ?? [蹂듦뎄 ?꾨즺] ?좉퇋 ?숈깮 ?깅줉 (A???섏떇 蹂댄샇 & 援ш? ?쒗듃 ??????
// =================================================================
window.saveNewStudent = async function () {
  const name = document.getElementById('newStuName').value.trim();
  const school = document.getElementById('newStuSchool').value.trim();
  let grade = document.getElementById('newStuGrade').value;
  const phone = document.getElementById('newStuPhone').value.trim();
  const parentPhone = document.getElementById('newStuParentPhone').value.trim();

  if (!name) return alert('?숈깮 ?대쫫???낅젰?댁＜?몄슂!');
  if (!parentPhone) return alert('?숇?紐??곕씫泥섎? ?낅젰?댁＜?몄슂!');

  // ?숇뀈(?? 珥?)??諛뷀깢?쇰줈 ?숇?(珥덈벑遺)? ?숇뀈 ?щ㎎(1?숇뀈) ?먮룞 蹂??
  let dept = '';
  if (grade) {
    if (grade.includes('珥?)) dept = '珥덈벑遺';
    else if (grade.includes('以?)) dept = '以묐벑遺';
    else if (grade.includes('怨?)) dept = '怨좊벑遺';

    grade = grade.replace(/[珥덉쨷怨?/g, '') + '?숇뀈'; // '珥?' -> '1?숇뀈'
  }

  if (confirm(`[${name}] ?숈깮???좉퇋 ?깅줉?섏떆寃좎뒿?덇퉴?`)) {
    const btn = document.querySelector('#newStudentModal .btn-primary');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> ?깅줉 以?..';
    btn.disabled = true;

    try {
      const today = new Date().toISOString().substring(0, 10);
      const sheetName = (typeof CONFIG !== 'undefined' && CONFIG.SHEETS && CONFIG.SHEETS.STUDENT) ? CONFIG.SHEETS.STUDENT : '?먯쿇DB';

      // ?뮕 [沅곴레???섏떇 蹂댄샇 ?⑥튂] A?댁쓣 嫄대뱶由ъ? ?딄린 ?꾪빐 B?댁쓽 湲몄씠瑜??ъ꽌 鍮?以꾩쓣 李얠뒿?덈떎.
      const res = await callSheetsAPI('GET', `/values/${encodeURIComponent(sheetName + '!B:B')}`);
      const bCol = res.values || [];
      const nextRow = bCol.length + 1;

      // ?뮕 B?대???L?닿퉴吏 ?ㅼ뼱媛??곗씠??諛곗뿴 ?앹꽦
      const rowData = [
        name,           // B: ?숈깮紐?
        dept,           // C: ?숇?
        school,         // D: ?숆탳
        grade,          // E: ?숇뀈
        "",             // F: 諛쁈D
        "",             // G: 媛뺤궗ID
        "?ъ썝",         // H: ?ъ썝?곹깭
        today,          // I: ?깅줉??
        "",             // J: 醫낅즺??
        parentPhone,    // K: 遺紐??곕씫泥?
        phone           // L: ?숈깮 ?곕씫泥?
      ];

      // ?뮕 PUT 諛⑹떇?쇰줈 ?뺥솗?섍쾶 B~L??移몄뿉留?諛???ｌ뒿?덈떎.
      await callSheetsAPI('PUT',
        `/values/${encodeURIComponent(sheetName + '!B' + nextRow + ':L' + nextRow)}?valueInputOption=USER_ENTERED`,
        { values: [rowData] }
      );

      alert(`??[${name}] ?숈깮???깃났?곸쑝濡??깅줉?섏뿀?듬땲??`);

      const modalEl = document.getElementById('newStudentModal');
      const modalInst = bootstrap.Modal.getInstance(modalEl);
      if (modalInst) modalInst.hide();

      // ????꾨즺 ???붾㈃ ?덈줈怨좎묠
      if (typeof forceRefresh === 'function') forceRefresh();

    } catch (e) {
      alert('?깅줉 ?ㅽ뙣: ' + e.message);
    } finally {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  }
};
