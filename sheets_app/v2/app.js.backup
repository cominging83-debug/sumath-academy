      const makeups = (appCache.raw['蹂닿컯?쇱젙DB'] || []).filter(m => m[0] === s[0] && m[8] !== '?꾨즺');
      return makeups.length > 0 && s[7] === '?ъ썝';
    });
  } else if (target === 'absent') {
    selected = students.filter(s => s[7] !== '?ъ썝');
  } else {
    selected = students;
  }

  alert(`?좏깮???숈깮: ${selected.length}紐?n\n${selected.map(s => s[1]).join(', ')}`);
};

