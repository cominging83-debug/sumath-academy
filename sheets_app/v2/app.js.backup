window.markMakeupComplete = async function (encodedA) {
  const a = JSON.parse(decodeURIComponent(encodedA));
  if (!confirm(`[${a.student}] ?숈깮??蹂닿컯 ?섏뾽???꾨즺(異쒖꽍) 泥섎━?섏떆寃좎뒿?덇퉴?`)) return;

  const today = new Date().toISOString().substring(0, 10);
  const timestamp = new Date().toLocaleString('ko-KR');

  showLoader(true, "蹂닿컯 ?꾨즺 泥섎━ 以?..");
  try {
    // 異쒓껐湲곕줉 而щ읆 留ㅽ븨
    const rowData = [
      timestamp, a.studentId || '', a.student, today, a.teacher, '蹂닿컯', '?놁쓬', '', '', '', '', '?쇱씪', '', '', '', '', '', `[${a.date} 寃곗꽍] 蹂닿컯?꾨즺`, '理쒖쥌', '', ''
    ];

    const sheetName = (typeof CONFIG !== 'undefined' && CONFIG.SHEETS && CONFIG.SHEETS.ATTENDANCE) ? CONFIG.SHEETS.ATTENDANCE : '異쒓껐湲곕줉';
    await callSheetsAPI('POST', `/values/${encodeURIComponent(sheetName)}:append?valueInputOption=USER_ENTERED`, { values: [rowData] });

    showLoader(false);
    alert(`[${a.student}] 蹂닿컯 ?꾨즺 泥섎━ ?섏뿀?듬땲?? ??);
    forceRefresh();
  } catch (e) {
    showLoader(false);
    alert('泥섎━ ?ㅽ뙣: ' + e.message);
  }
};

