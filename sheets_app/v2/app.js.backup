// ?숈깮 ?뺣낫 ?섏젙 紐⑤떖 (?섏젙 踰꾪듉 怨좎옣 ?닿껐 & ?댁썝 ?곕룞 & ?숇뀈 踰꾧렇 ?쎌뒪)
// =========================================
window.openStudentEditModal = function (studentId) {
  const students = appCache.raw.students || [];
  const s = students.find(r => r[0] === studentId);
  if (!s) { alert('?숈깮 ?뺣낫瑜?李얠쓣 ???놁뒿?덈떎.'); return; }

  // 湲곗〈 紐⑤떖 ?쒓굅
  const existing = document.getElementById('studentEditModal');
  if (existing) existing.remove();

  const statusOptions = ['?ъ썝', '?댁썝', '?댁썝'].map(st =>
    `<option value="${st}" ${(s[7] || '') === st ? 'selected' : ''}>${st}</option>`
  ).join('');

  // ?뮕 [?듭떖 踰꾧렇 ?섏젙] ?쒗듃 媛믨낵 ?숈씪?섍쾶 1~6?숇뀈?쇰줈 ?좏깮吏 ?듭씪 (鍮덉뭏 ?좎븘媛?諛⑹?)
  const gradeOptions = ['1?숇뀈', '2?숇뀈', '3?숇뀈', '4?숇뀈', '5?숇뀈', '6?숇뀈'].map(g =>
    `<option value="${g}" ${(s[4] || '').includes(g.replace('?숇뀈', '')) ? 'selected' : ''}>${g}</option>`
  ).join('');

  const el = document.createElement('div');
  el.innerHTML = `
    <div class="modal fade" id="studentEditModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
          <div class="modal-header bg-secondary text-white">
            <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>${s[1]} ?뺣낫 ?섏젙</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            <input type="hidden" id="edit-student-id" value="${studentId}">
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label fw-bold small">?대쫫</label>
                <input type="text" id="edit-name" class="form-control" value="${s[1] || ''}">
              </div>
              <div class="col-6">
                <label class="form-label fw-bold small">?숆탳紐?/label>
                <input type="text" id="edit-school" class="form-control" value="${s[3] || ''}">
              </div>
              <div class="col-6">
                <label class="form-label fw-bold small">?숇뀈</label>
                <select id="edit-grade" class="form-select">
                  <option value="">?좏깮</option>${gradeOptions}
                </select>
              </div>
              <div class="col-6">
                <label class="form-label fw-bold small">?ъ썝 ?곹깭 狩?/label>
                <select id="edit-status" class="form-select fw-bold border-warning text-danger">
                  ${statusOptions}
                </select>
                <div class="form-text text-danger small"><i class="bi bi-info-circle"></i> '?댁썝' 泥섎━ ???쒓컙?쒖뿉???먮룞 ??젣?⑸땲??</div>
              </div>
              <div class="col-6">
                <label class="form-label fw-bold small">?숇?紐??곕씫泥?/label>
                <input type="text" id="edit-parent-phone" class="form-control" value="${s[10] || ''}">
              </div>
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">痍⑥냼</button>
            <button class="btn btn-primary rounded-pill fw-bold px-4" onclick="saveStudentEdit()">
              <i class="bi bi-check-circle-fill me-1"></i>???
            </button>
          </div>
        </div>
      </div>
    </div>`;
  document.body.appendChild(el.firstElementChild);
  new bootstrap.Modal(document.getElementById('studentEditModal')).show();
};

// ?? [?듭떖] ?숈깮 ?섏젙 諛??댁썝 ???쒓컙???곕룞 ??젣
window.saveStudentEdit = async function () {
  const studentId = document.getElementById('edit-student-id').value;
  const name = document.getElementById('edit-name').value.trim();
  const school = document.getElementById('edit-school').value.trim();
  // ?뮕 [?섏젙] ?뺢퇋?앹쑝濡?'珥?以?怨? 湲?먮? 吏?곗? ?딄퀬 '1?숇뀈' ?뺥깭 洹몃?濡?媛?멸컧
  const grade = document.getElementById('edit-grade').value;
  const status = document.getElementById('edit-status').value;
  const parentPhone = document.getElementById('edit-parent-phone').value.trim();

  if (!name) { alert('?대쫫???낅젰?댁＜?몄슂.'); return; }

  showLoader(true, "?숈깮 ?뺣낫瑜??낅뜲?댄듃?섎뒗 以?..");
  try {
    // 1. ?먯쿇DB (STUDENT) ?뺣낫 ?낅뜲?댄듃
    await updateStudentData(studentId, { name, school, grade, status, parentPhone });

    // 2. 留뚯빟 ?곹깭媛 '?댁썝'?쇰줈 諛붾뚯뿀?ㅻ㈃, ?섍컯?쇱젙DB(SCHEDULE)?먯꽌 鍮꾪솢?깊솕(??젣) 泥섎━
    if (status === '?댁썝' || status === '?댁썝') {
      const scheduleRes = await callSheetsAPI('GET', `/values/${encodeURIComponent(CONFIG.SHEETS.SCHEDULE)}!A:O`);
      const schedVals = scheduleRes.values || [];
      const updateBatch = [];

      for (let i = 1; i < schedVals.length; i++) {
        const row = schedVals[i];
        if ((row[0] && (row[0].includes(name) || row[0].includes(studentId))) || row[3] === studentId) {
          const rowNum = i + 1;
          updateBatch.push({
            range: `${CONFIG.SHEETS.SCHEDULE}!O${rowNum}`,
            values: [["鍮꾪솢??]]
          });
        }
      }

      if (updateBatch.length > 0) {
        await callSheetsAPI('POST', `/values:batchUpdate`, {
          valueInputOption: "USER_ENTERED",
          data: updateBatch
        });
        console.log(`[?댁썝/?댁썝 泥섎━] ?쒓컙??${updateBatch.length}嫄?鍮꾪솢?깊솕 ?꾨즺`);
      }
    }

    showLoader(false);
    alert(`[${name}] ?숈깮 ?뺣낫媛 ?섏젙?섏뿀?듬땲?? ??n(${status} 泥섎━ ???쒓컙?쒖뿉?쒕룄 ?쒖쇅?⑸땲??`);

    bootstrap.Modal.getInstance(document.getElementById('studentEditModal')).hide();
    forceRefresh();

  } catch (e) {
    showLoader(false);
    alert('?섏젙 ?ㅽ뙣: ' + e.message);
  }
};

