              <div class="col-md-2">
                <label class="form-label fw-bold small text-muted">?섍컯 ?좏삎</label>
                <select class="form-select" id="regClassType">
                  <option value="?뺢퇋">?뺢퇋</option>
                  <option value="?댁떊">?댁떊</option>
