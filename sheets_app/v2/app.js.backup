window.loadBookView = function () {
  const books = appCache.raw.books || [];

  const isManager = (appCache.user.role === '?먯옣');
  const myBooks = isManager ? books : books.filter(b => b[2] === appCache.user.name);

  let html = `
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="fw-bold m-0"><i class="bi bi-book-fill text-primary me-2"></i>援먯옱 愿由?/h3>
      <button class="btn btn-primary rounded-pill fw-bold shadow-sm" onclick="openBookModal()">
        <i class="bi bi-plus-lg me-1"></i> 援먯옱 ?깅줉
      </button>
    </div>
    
    <div class="card shadow-sm border-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle m-0" style="min-width: 900px;">
          <thead class="table-light">
            <tr>
              <th>?쒕쾲</th>
              <th>援먯옱紐?/th>
              <th>遺꾨쪟</th>
              <th>媛寃?/th>
              <th>?꾩껜 ?섏씠吏</th>
              <th>?깅줉?쇱옄</th>
              <th>湲곕뒫</th>
            </tr>
          </thead>
          <tbody>
  `;

  if (myBooks.length === 0) {
    html += `<tr><td colspan="7" class="text-center py-5 text-muted">?깅줉??援먯옱媛 ?놁뒿?덈떎.</td></tr>`;
  } else {
    myBooks.slice().reverse().forEach((b, idx) => {
      const bookName = b[0] || '-';
      const category = b[1] || '-';
      const feeRaw = b[2] || '';
      const totalPages = b[3] || '0';
      const regDate = b[4] || '-';

      // ?뮕 [?듭떖 ?섏닠] 湲덉븸 ?щ㎎???ㅻ쪟(NaN) ?닿껐
      // ?쒗듃??"15,000" ?대굹 "15000?? ?대씪怨??곹??덉뼱???뺤닔湲곗쿂???レ옄留???戮묒븘??
      const cleanFee = feeRaw.toString().replace(/[^0-9]/g, '');
      const formattedFee = cleanFee ? Number(cleanFee).toLocaleString() + '?? : '-';

      html += `
        <tr>
          <td class="text-muted small">${myBooks.length - idx}</td>
          <td class="fw-bold text-primary">${bookName}</td>
          <td><span class="badge bg-secondary bg-opacity-10 text-dark border fw-normal">${category}</span></td>
          <td class="fw-bold text-success">${formattedFee}</td>
          <td class="small">珥?<b>${totalPages}</b> P</td>
          <td class="text-muted small">${regDate}</td>
          <td>
            <button class="btn btn-sm btn-outline-danger" onclick="alert('?곗씠??蹂댄샇瑜??꾪빐 ??젣???먯옣?섏쓣 ?듯빐?쒕쭔 愿由ы븷 ???덉뒿?덈떎.')"><i class="bi bi-trash"></i></button>
          </td>
        </tr>
      `;
    });
  }

  html += `
          </tbody>
        </table>
      </div>
    </div>
  `;

  // 紐⑤떖 ?숈쟻 二쇱엯 (理쒖큹 1?뚮쭔)
  if (!document.getElementById('bookModal')) {
    const modalHtml = `
      <div class="modal fade" id="bookModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
              <h5 class="modal-title fw-bold"><i class="bi bi-journal-plus"></i> ??援먯옱 ?깅줉</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
              <div class="row g-3">
                <div class="col-8">
                  <label class="form-label fw-bold text-muted small">援먯옱紐?<span class="text-danger">*</span></label>
                  <input type="text" id="b-name" class="form-control fw-bold text-primary" placeholder="?? 媛쒕뀗?먮━ 以?-1">
                </div>
                <div class="col-4">
                  <label class="form-label fw-bold text-muted small">遺꾨쪟 <span class="text-danger">*</span></label>
                  <select id="b-category" class="form-select">
                    <option value="媛쒕뀗??>媛쒕뀗??/option>
                    <option value="?좏삎??>?좏삎??/option>
                    <option value="?ы솕??>?ы솕??/option>
                    <option value="湲곗텧臾몄젣">湲곗텧臾몄젣</option>
                    <option value="?곗궛">?곗궛</option>
                    <option value="湲고?">湲고?</option>
                  </select>
                </div>
                <div class="col-6">
                  <label class="form-label fw-bold text-muted small">?꾩껜 ?섏씠吏 ??<span class="text-danger">*</span></label>
                  <div class="input-group">
                    <input type="number" id="b-pages" class="form-control" placeholder="?? 250">
                    <span class="input-group-text">P</span>
                  </div>
                </div>
                <div class="col-6">
                  <label class="form-label fw-bold text-muted small">援먯옱鍮?(??</label>
                  <input type="number" id="b-fee" class="form-control" placeholder="?? 15000">
                </div>
              </div>
            </div>
            <div class="modal-footer bg-light">
              <button type="button" class="btn btn-secondary rounded-pill fw-bold" data-bs-dismiss="modal">痍⑥냼</button>
              <button type="button" id="btn-save-book" class="btn btn-primary rounded-pill fw-bold px-4" onclick="saveBook()">援먯옱 ???/button>
            </div>
          </div>
        </div>
      </div>
    `;
    document.body.insertAdjacentHTML('beforeend', modalHtml);
  }

  document.getElementById('view-container').innerHTML = html;
};

