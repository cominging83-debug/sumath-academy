window.loadCounselView = function () {
  if (!appCache.raw || !appCache.raw.counsels) {
    document.getElementById('view-container').innerHTML = '<p>?곗씠?곕? 遺덈윭?????놁뒿?덈떎.</p>'; return;
  }
  const counsels = appCache.raw.counsels;
  let cList = [];
  const myName = appCache.user.name;
  const isManager = (appCache.user.role === '?먯옣');

  for (let i = counsels.length - 1; i >= 1; i--) {
    const r = counsels[i]; if (!r[0]) continue;
    const counselTeacher = (r[6] || '').split('(')[0].trim();
    if (!isManager && counselTeacher !== myName) continue;
    cList.push({ date: r[4] ? r[4].substring(0, 10) : (r[0] ? r[0].substring(0, 10) : '-'), student: r[1], schoolInfo: r[3], type: r[5], teacher: r[6], target: r[7], memo: r[8] });
  }

  const counselTypes = [...new Set(cList.map(c => c.type).filter(t => t))];
  const counselTeachers = [...new Set(cList.map(c => c.teacher).filter(t => t))];

  let html = `
    <div class="mb-4">
      <h3 class="fw-bold mb-3"><i class="bi bi-chat-dots text-info me-2"></i>?곷떞 湲곕줉</h3>

      <div class="card border-0 shadow-sm p-3 mb-3 bg-light">
        <div class="row g-2 align-items-end">
          <div class="col-md-3">
            <label class="form-label small fw-bold mb-1">?숈깮紐?/label>
            <input type="text" id="counselSearchInput" class="form-control form-control-sm border-info" placeholder="?뵇 ?숈깮紐?..">
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-bold mb-1">?곷떞?좏삎</label>
            <select class="form-select form-select-sm" id="counselTypeFilter">
              <option value="">?꾩껜</option>
              ${counselTypes.map(t => `<option value="${t}">${t}</option>`).join('')}
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-bold mb-1">?대떦 媛뺤궗</label>
            <select class="form-select form-select-sm" id="counselTeacherFilter">
              <option value="">?꾩껜</option>
              ${counselTeachers.map(t => `<option value="${t}">${t}</option>`).join('')}
            </select>
          </div>
          <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-info btn-sm fw-bold flex-grow-1" onclick="applyCounselFilters()"><i class="bi bi-search"></i> 寃??/button>
            <button class="btn btn-outline-secondary btn-sm fw-bold" onclick="resetCounselFilters()"><i class="bi bi-arrow-counterclockwise"></i></button>
          </div>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm p-4 border-top border-info border-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="badge bg-info-light text-info" id="counselCountBadge">${cList.length}嫄?/span>
        <button class="btn btn-info btn-sm fw-bold rounded-pill text-white text-nowrap" onclick="openCounselModal()"><i class="bi bi-pencil-square"></i> ???깅줉</button>
      </div>
      <div class="table-responsive" style="max-height: 600px;">
        <table class="table table-hover align-middle table-sm" id="counselTable">
          <thead class="bg-light sticky-top"><tr><th style="width: 110px;">?곷떞?쇱옄</th><th style="width: 100px;">?숈깮紐?/th><th style="width: 120px;">?숆탳紐?/th><th style="width: 150px;">?곷떞?좏삎</th><th style="width: 80px;">?대떦??/th><th>?곷떞?댁슜</th></tr></thead>
          <tbody>
  `;

  if (cList.length === 0) {
    html += `<tr><td colspan="6" class="text-center py-5 text-muted">?깅줉???곷떞 湲곕줉???놁뒿?덈떎.</td></tr>`;
  } else {
    cList.forEach(c => {
      let typeBadge = 'bg-secondary';
      if (c.type === '?좉퇋?곷떞') typeBadge = 'bg-primary';
      else if (c.type === '?뺢린 ?곷떞') typeBadge = 'bg-success';
      else if (c.type === '?숇?紐??꾪솕 ?곷떞 ?붿껌') typeBadge = 'bg-info text-dark border border-info';
      else if (c.type === '?硫댁긽??) typeBadge = 'bg-warning text-dark';
      else if (c.type === '?댁썝?곷떞') typeBadge = 'bg-danger';
      html += `<tr style="cursor: pointer;" onclick="showCounselDetail('${c.student}', '${c.date}', '${(c.memo || '').replace(/'/g, "\\'")}')">
        <td><span class="text-muted fw-bold small"><i class="bi bi-calendar"></i> ${c.date}</span></td>
        <td class="fw-bold">${c.student}</td>
        <td class="text-muted small">${c.schoolInfo || '-'}</td>
        <td><span class="badge ${typeBadge} rounded-pill px-2">${c.type || '-'}</span></td>
        <td class="small">${c.teacher || '-'}</td>
        <td style="font-size: 0.85rem;" class="text-muted">${(c.memo || '').substring(0, 50)}${(c.memo || '').length > 50 ? '...' : ''}</td>
      </tr>`;
    });
  }
  html += `</tbody></table></div></div>`;
  document.getElementById('view-container').innerHTML = html;
};

window.applyCounselFilters = function() {
  const searchText = document.getElementById('counselSearchInput').value.toLowerCase();
  const typeFilter = document.getElementById('counselTypeFilter').value;
  const teacherFilter = document.getElementById('counselTeacherFilter').value;

  const rows = document.querySelectorAll('#counselTable tbody tr');
  let visibleCount = 0;

  rows.forEach(row => {
    if (row.cells.length < 6) return;

    const studentName = row.cells[1].textContent.toLowerCase();
    const counselType = row.cells[3].textContent;
    const teacher = row.cells[4].textContent;

    const matchSearch = studentName.includes(searchText);
    const matchType = !typeFilter || counselType.includes(typeFilter);
    const matchTeacher = !teacherFilter || teacher.includes(teacherFilter);

    if (matchSearch && matchType && matchTeacher) {
      row.style.display = '';
      visibleCount++;
    } else {
      row.style.display = 'none';
    }
  });

  document.getElementById('counselCountBadge').textContent = `${visibleCount}嫄?;
};

window.resetCounselFilters = function() {
  document.getElementById('counselSearchInput').value = '';
  document.getElementById('counselTypeFilter').value = '';
  document.getElementById('counselTeacherFilter').value = '';

  const rows = document.querySelectorAll('#counselTable tbody tr');
  rows.forEach(row => row.style.display = '');

  document.getElementById('counselCountBadge').textContent = `${rows.length}嫄?;
};

window.showCounselDetail = function(student, date, memo) {
  alert(`?뱥 ?곷떞 湲곕줉\n\n?숈깮: ${student}\n?좎쭨: ${date}\n\n?댁슜:\n${memo || '硫붾え ?놁쓬'}`);
};

// ?곷떞?좏삎???곕Ⅸ ?붾㈃ ?좉?
window.toggleCounselType = function () {
  const type = document.getElementById('c-type').value;
  const existWrap = document.getElementById('c-existing-wrap');
  const newWrap = document.getElementById('c-new-wrap');
  if (type === '?좉퇋?곷떞') {
    existWrap.classList.add('d-none');
    newWrap.classList.remove('d-none');
  } else {
    existWrap.classList.remove('d-none');
    newWrap.classList.add('d-none');
  }
};

// ???곷떞 紐⑤떖 ?닿린
window.openCounselModal = function () {
  let existing = document.getElementById('counselModal');
  if (existing) existing.remove();

  let studentOptions = '';
  if (appCache.raw && appCache.raw.students) {
    let sorted = [];
    for (let i = 1; i < appCache.raw.students.length; i++) {
      if (appCache.raw.students[i][0]) sorted.push({ id: appCache.raw.students[i][0], name: appCache.raw.students[i][1], school: appCache.raw.students[i][3], grade: appCache.raw.students[i][4] });
    }
    sorted.sort((a, b) => a.name.localeCompare(b.name)).forEach(s => {
      studentOptions += `<option value="${s.name} (${s.school}/${s.grade})" data-id="${s.id}"></option>`;
    });
  }

  const modalHtml = `
  <div class="modal fade" id="counselModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg">
        <div class="modal-header bg-info text-white">
          <h5 class="modal-title fw-bold"><i class="bi bi-chat-dots-fill"></i> ?곷떞 湲곕줉 ?깅줉</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4 bg-light">
          <div class="row g-3">
            <div class="col-6">
              <label class="form-label fw-bold small text-muted">?곷떞 ?좏삎 <span class="text-danger">*</span></label>
              <select id="c-type" class="form-select border-info" onchange="toggleCounselType()">
                <option value="?뺢린 ?곷떞" selected>?뺢린 ?곷떞</option>
                <option value="?좉퇋?곷떞">?좉퇋?곷떞</option>
                <option value="?숇?紐??꾪솕 ?곷떞 ?붿껌">?숇?紐??꾪솕 ?곷떞</option>
                <option value="?硫댁긽??>?硫댁긽??/option>
                <option value="?댁썝?곷떞">?댁썝?곷떞</option>
                <option value="湲고?">湲고?</option>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label fw-bold small text-muted">?곷떞 ???/label>
              <select id="c-target" class="form-select">
                <option value="?숇?紐?>?숇?紐?/option>
                <option value="?숈깮">?숈깮</option>
              </select>
            </div>

            <div class="col-12" id="c-existing-wrap">
              <label class="form-label fw-bold small text-muted">?숈깮 寃??<span class="text-danger">*</span></label>
              <input type="text" id="c-studentInput" class="form-control fw-bold border-info" list="c-studentList" placeholder="?대쫫 寃????諛섎뱶??紐⑸줉?먯꽌 ?대┃?섏꽭?? autocomplete="off" onchange="document.getElementById('c-studentId').value = this.list.querySelector('option[value=\\''+this.value+'\\']')?.dataset.id || ''">
              <datalist id="c-studentList">${studentOptions}</datalist>
              <input type="hidden" id="c-studentId">
            </div>

            <div class="col-12 d-none" id="c-new-wrap">
              <div class="row g-2">
                <div class="col-6">
                  <label class="form-label fw-bold small text-muted">?좉퇋 ?숈깮 ?대쫫 <span class="text-danger">*</span></label>
                  <input type="text" id="c-newName" class="form-control border-info" placeholder="?띻만??>
                </div>
                <div class="col-6">
                  <label class="form-label fw-bold small text-muted">?곕씫泥?/label>
                  <input type="text" id="c-newPhone" class="form-control" placeholder="010-0000-0000">
                </div>
              </div>
            </div>

            <div class="col-12">
              <label class="form-label fw-bold small text-muted">?곷떞 ?댁슜 (?곸꽭?? <span class="text-danger">*</span></label>
              <textarea id="c-memo" class="form-control" rows="6" placeholder="?곷떞 ?댁슜???낅젰?섏꽭??"></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer bg-white">
          <button class="btn btn-secondary rounded-pill fw-bold" data-bs-dismiss="modal">痍⑥냼</button>
          <button class="btn btn-info text-white rounded-pill fw-bold px-4 shadow-sm" onclick="saveCounsel()"><i class="bi bi-check-circle-fill me-1"></i> ??ν븯湲?/button>
        </div>
      </div>
    </div>
  </div>`;
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  new bootstrap.Modal(document.getElementById('counselModal')).show();
};

// =================================================================
// ?? [怨좎냽 ?듭떊] ?곷떞 湲곕줉 5G ???(IME 踰꾧렇 諛⑹뼱 + 諛由??꾩긽 ?꾨꼍 李⑤떒)
// =================================================================
window.saveCounsel = async function () {
  const type = document.getElementById('c-type') ? document.getElementById('c-type').value : (document.getElementById('counsel-type')?.value || '湲고?');
  const target = document.getElementById('c-target') ? document.getElementById('c-target').value : (document.getElementById('counsel-target')?.value || '湲고?');
  const memo = document.getElementById('c-memo') ? document.getElementById('c-memo').value.trim() : (document.getElementById('counsel-content')?.value.trim() || '');

  let name = ''; let studentId = ''; let schoolInfo = ''; let contact = '';
  let date = document.getElementById('counsel-date') ? document.getElementById('counsel-date').value : new Date().toISOString().substring(0, 10);
  let teacher = document.getElementById('counsel-teacher') ? document.getElementById('counsel-teacher').value.trim() : appCache.user.name;

  if (type === '?좉퇋?곷떞' && document.getElementById('c-newName') && !document.getElementById('c-newName').classList.contains('d-none')) {
    name = document.getElementById('c-newName').value.trim();
    contact = document.getElementById('c-newPhone').value.trim();
    if (!name) return alert("?좉퇋 ?숈깮???대쫫???낅젰?댁＜?몄슂.");
    if (contact) schoolInfo = `[?곕씫泥? ${contact}]`;
  } else {
    const idInput = document.getElementById('c-studentId') || document.getElementById('counsel-student-id');
    const searchInput = document.getElementById('c-studentInput') || document.getElementById('counsel-student-search');
    studentId = idInput ? idInput.value : '';
    let inputVal = searchInput ? searchInput.value.trim() : '';

    // ?뮕 [踰꾧렇 ?쎌뒪 1] ?쒓? ?먮룞?꾩꽦 ?대┃ ??留??ㅼ뿉 湲?먭? ?섎굹 ??遺숇뒗 ?꾩긽 諛⑹뼱!
    if (!studentId && inputVal) {
      const options = document.getElementById('c-studentList')?.options || [];
      const namePartOnly = inputVal.split('(')[0].trim();

      for (let i = 0; i < options.length; i++) {
        if (options[i].value === inputVal || inputVal.startsWith(options[i].value) || options[i].value.startsWith(namePartOnly + " (")) {
          studentId = options[i].dataset.id;
          if (idInput) idInput.value = studentId;
          if (searchInput) {
            searchInput.value = options[i].value;
            inputVal = options[i].value;
          }
          break;
        }
      }
    }

    if (!studentId || !inputVal) return alert("?숈깮??寃?됲븯怨?紐⑸줉?먯꽌 諛섎뱶???좏깮?댁＜?몄슂.\n(?대쫫???낅젰 ???섑??섎뒗 ?쒕∼?ㅼ슫???대┃?댁＜?몄슂)");
    name = inputVal.split(' (')[0];
    schoolInfo = inputVal.includes('(') ? inputVal.substring(inputVal.indexOf('(') + 1, inputVal.indexOf(')')) : (document.getElementById('counsel-student-school')?.value || '');
  }

  if (!memo) return alert("?곷떞 ?댁슜???낅젰?댁＜?몄슂.");

  showLoader(true, "?곷떞 湲곕줉 ???以?..");

  try {
    const timestamp = new Date().toLocaleString('ko-KR');
    // A:?쇱옄, B:?숈깮紐? C:?숈깮ID, D:?숆탳/?숇뀈, E:?곷떞?쇱옄, F:?곷떞?좏삎, G:?대떦?? H:?곷떞??? I:?곷떞?댁슜
    const rowData = [timestamp, name, studentId, schoolInfo, date, type, teacher, target, memo];
    const sheetName = (typeof CONFIG !== 'undefined' && CONFIG.SHEETS && CONFIG.SHEETS.COUNSEL) ? CONFIG.SHEETS.COUNSEL : '?곷떞?쇱?';

    // ?뮕 [踰꾧렇 ?쎌뒪 2] 援ш? ?쒗듃 留섎?濡?E?대?????λ릺???꾩긽 諛⑹? (A~I 援ъ뿭 媛뺤젣 ??????
    const res = await callSheetsAPI('GET', `/values/${encodeURIComponent(sheetName + '!A:I')}`);
    const existRows = res.values || [];
    const nextRow = existRows.length + 1; // 鍮?以?李얘린

    await callSheetsAPI('PUT', `/values/${encodeURIComponent(sheetName + '!A' + nextRow + ':I' + nextRow)}?valueInputOption=USER_ENTERED`, { values: [rowData] });

    showLoader(false);
    alert("???곷떞?쇱?媛 1珥?留뚯뿉 ?깅줉?섏뿀?듬땲??");

    const modalEl = document.getElementById('counselModal');
    if (modalEl) {
      let modal = bootstrap.Modal.getInstance(modalEl);
      if (modal) modal.hide();
    }

    if (typeof refreshCounselData === 'function') {
      await refreshCounselData();
    } else {
      forceRefresh();
    }
  } catch (error) {
    showLoader(false);
    alert("?곷떞 ????ㅽ뙣: " + error.message);
  }
};

// =========================================
// 媛뺤궗 洹쇳깭(異쒗눜洹? 愿由??붾㈃
// =========================================
function loadTeacherAttView() {
  const tattRecords = appCache.raw.tatt || [];

  // ???대쾲??異쒗눜洹?湲곕줉留??꾪꽣留?
  const currentMonth = new Date().toISOString().substring(0, 7);
  const today = new Date().toISOString().substring(0, 10);

  let myRecords = tattRecords.filter(r => {
    return r[1] === appCache.user.name && (r[2] || '').startsWith(currentMonth);
  });

  // ??닚 ?뺣젹 (理쒖떊 湲곕줉???꾨줈)
  myRecords = myRecords.reverse();

  // [v2 ?좉퇋] ?ㅻ뒛 ?곹깭 怨꾩궛
  const todayRecords = myRecords.filter(r => (r[2] || '').substring(0, 10) === today);
  const todayCheckin = todayRecords.find(r => r[4] === '異쒓렐');
  const todayCheckout = todayRecords.find(r => r[4] === '?닿렐');

  let statusHTML = '<div class="alert alert-light border-2 border-info p-3 text-center mb-3" style="border-radius: 12px;">';
  if (todayCheckin && todayCheckout) {
    statusHTML += `<div class="fw-bold text-success" style="font-size: 1.1rem;"><i class="bi bi-check-circle-fill me-2"></i>?ㅻ뒛 洹쇰Т ?꾨즺</div>`;
    statusHTML += `<small class="text-muted">${todayCheckin[3]} ~ ${todayCheckout[3]}</small>`;
  } else if (todayCheckin) {
    statusHTML += `<div class="fw-bold text-info" style="font-size: 1.1rem;"><i class="bi bi-clock-fill me-2"></i>洹쇰Т 以?/div>`;
    statusHTML += `<small class="text-muted">異쒓렐: ${todayCheckin[3]}</small>`;
  } else {
    statusHTML += `<div class="fw-bold text-warning" style="font-size: 1.1rem;"><i class="bi bi-moon-stars-fill me-2"></i>?꾩쭅 異쒓렐?섏? ?딆쓬</div>`;
    statusHTML += `<small class="text-muted">?ㅻ뒛 異쒓렐??湲곕줉?댁＜?몄슂</small>`;
  }
  statusHTML += '</div>';

  let html = `
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="fw-bold m-0"><i class="bi bi-clock-history text-primary me-2"></i>異쒗눜洹?愿由?/h3>
      <div>
        <span class="badge bg-light text-dark border me-2 fs-6">${currentMonth}</span>
        <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="refreshTeacherAttData()">
          <i class="bi bi-arrow-clockwise"></i> ?덈줈怨좎묠
        </button>
      </div>
    </div>

    ${statusHTML}

    <div class="row g-3 mb-4">
      <div class="col-6">
        <button class="btn btn-primary w-100 py-4 shadow-sm rounded-4 fw-bold fs-5" id="btn-checkin" onclick="recordTeacherAtt('異쒓렐')" ${todayCheckin ? 'disabled' : ''}>
          <i class="bi bi-box-arrow-in-right mb-2 d-block fs-1"></i>
          ${todayCheckin ? '異쒓렐?? : '異쒓렐?섍린'}
        </button>
      </div>
      <div class="col-6">
        <button class="btn btn-danger w-100 py-4 shadow-sm rounded-4 fw-bold fs-5" id="btn-checkout" onclick="recordTeacherAtt('?닿렐')" ${todayCheckout || !todayCheckin ? 'disabled' : ''}>
          <i class="bi bi-box-arrow-right mb-2 d-block fs-1"></i>
          ${todayCheckout ? '?닿렐?? : '?닿렐?섍린'}
        </button>
      </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">
      <div class="card-header bg-white border-0 pt-4 pb-0">
        <h6 class="fw-bold m-0"><i class="bi bi-list-check me-2 text-muted"></i>???대쾲 ??湲곕줉</h6>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle m-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">?쇱옄</th>
                <th>?쒓컙</th>
                <th>援щ텇</th>
              </tr>
            </thead>
            <tbody>
  `;

  if (myRecords.length === 0) {
    html += `<tr><td colspan="3" class="text-center py-5 text-muted">?대쾲 ??異쒗눜洹?湲곕줉???놁뒿?덈떎.</td></tr>`;
  } else {
    myRecords.forEach(r => {
      // r[0]: ??꾩뒪?ы봽, r[1]: ?대쫫, r[2]: ?좎쭨, r[3]: ?쒓컙, r[4]: 異쒓렐/?닿렐
      const date = r[2] || '-';
      const time = r[3] || '-';
      const type = r[4] || '-';

      const typeBadge = type === '異쒓렐' ? 'bg-primary' : (type === '?닿렐' ? 'bg-danger' : 'bg-secondary');

      html += `
        <tr>
          <td class="ps-4 fw-bold text-muted">${date}</td>
          <td class="fw-bold fs-5">${time}</td>
          <td><span class="badge ${typeBadge} rounded-pill px-3 py-2">${type}</span></td>
        </tr>
      `;
    });
  }

  html += `
            </tbody>
          </table>
        </div>
      </div>
    </div>
  `;

  document.getElementById('view-container').innerHTML = html;
}

// =================================================================
// ?? [怨좎냽 ?듭떊] 媛뺤궗 洹쇳깭(異쒗눜洹? 湲곕줉 5G ???
// =================================================================
window.recordTeacherAtt = async function (type) {
  if (!confirm(`吏湲??쒓컙?쇰줈 [${type}] 泥섎━?섏떆寃좎뒿?덇퉴?`)) return;

  const btnId = type === '異쒓렐' ? 'btn-checkin' : 'btn-checkout';
  const btn = document.getElementById(btnId);
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> 泥섎━以?..';
  }

  const now = new Date();
  const timestamp = now.toLocaleString('ko-KR');
  const dateStr = now.toISOString().substring(0, 10);
  const timeStr = now.toTimeString().substring(0, 5);

  try {
    const rowData = [timestamp, appCache.user.name, dateStr, timeStr, type];
    const body = { values: [rowData] };
    const sheetName = (typeof CONFIG !== 'undefined' && CONFIG.SHEETS && CONFIG.SHEETS.TATT) ? CONFIG.SHEETS.TATT : '媛뺤궗洹쇳깭';

    await callSheetsAPI('POST', `/values/${encodeURIComponent(sheetName)}:append?valueInputOption=USER_ENTERED`, body);

    alert(`??${type} 泥섎━媛 ?꾨즺?섏뿀?듬땲??`);

    if (typeof refreshTeacherAttData === 'function') {
      await refreshTeacherAttData();
    } else {
      forceRefresh();
    }
  } catch (err) {
    alert(`${type} 湲곕줉 ?ㅽ뙣: ` + err.message);
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = type === '異쒓렐' ? '<i class="bi bi-box-arrow-in-right mb-2 d-block fs-1"></i>異쒓렐?섍린' : '<i class="bi bi-box-arrow-right mb-2 d-block fs-1"></i>?닿렐?섍린';
    }
  }
};

// =================================================================
// ?? 異쒖꽍 紐⑤떖李??닿린 & ?ㅼ떆媛?誘몃━蹂닿린 ?좉? 湲곕뒫 ?듯빀蹂?
// =================================================================

// ?뮕 1. ?좉?(?묎린/?닿린) 湲곕뒫
window.isPreviewOpen = true; // 湲곕낯?곸쑝濡??대젮?덇쾶 ?ㅼ젙

window.toggleLivePreview = function () {
  const panel = document.getElementById('livePreviewPanel');
  const btn = document.getElementById('previewToggleBtn');
  if (!panel || !btn) return;

  window.isPreviewOpen = !window.isPreviewOpen;

  if (window.isPreviewOpen) {
    panel.style.display = 'block';
    setTimeout(() => panel.style.opacity = '1', 10);
    btn.style.display = 'none';
  } else {
    panel.style.opacity = '0';
    setTimeout(() => panel.style.display = 'none', 200);
    btn.style.display = 'block';
  }
};

// =================================================================
// ?? ?뚮┝???띿뒪???꾩꽦 (怨듯넻 吏꾨룄瑜?'醫낇빀?덈궡' 諛붾줈 ?꾨줈 ?먯뿰?ㅻ읇寃??대룞)
// =================================================================
window.generateAlimtalkText = function (idx) {
  const row = document.getElementById(`student-section-${idx}`);
  if (!row) return '';

  const sName = row.getAttribute('data-name') || '';
  const teacher = currentEventForModal ? currentEventForModal.teacherId : appCache.user.name;
  const dateObj = new Date(document.getElementById('checkDate').value || new Date());
  const dateStr = `${dateObj.getMonth() + 1}??${dateObj.getDate()}??;

  const attRadio = document.querySelector(`input[name="att_${idx}"]:checked`);
  const att = attRadio ? attRadio.value : '';
  const hwRadio = document.querySelector(`input[name="hw_${idx}"]:checked`);
  const hwStatus = hwRadio ? hwRadio.value : '誘몄엯??;

  const getVal = (id) => document.getElementById(id + '_' + idx)?.value || '';

  // ?곷떒 怨듯넻 吏꾨룄 媛?몄삤湲?
  const commonProgress = document.getElementById('classProgress') ? document.getElementById('classProgress').value.trim() : '';

  let progLines = [];
  // ?뮕 [?섏젙] 怨듯넻 吏꾨룄瑜?吏꾨룄移?progLines)?먯꽌 類먯뒿?덈떎. ?ㅼ쭅 媛쒕퀎 吏꾨룄留??ㅼ뼱媛묐땲??
  if (getVal('pB1') || getVal('pR1')) progLines.push((getVal('pB1') ? `[${getVal('pB1')}] ` : '') + getVal('pR1'));
  if (getVal('pB2') || getVal('pR2')) progLines.push((getVal('pB2') ? `[${getVal('pB2')}] ` : '') + getVal('pR2'));
  if (getVal('pB3') || getVal('pR3')) progLines.push((getVal('pB3') ? `[${getVal('pB3')}] ` : '') + getVal('pR3'));
  const prog = progLines.join('\n');

  let hwLines = [];
  if (getVal('hwB1') || getVal('hwR1')) hwLines.push((getVal('hwB1') ? `[${getVal('hwB1')}] ` : '') + getVal('hwR1'));
  if (getVal('hwB2') || getVal('hwR2')) hwLines.push((getVal('hwB2') ? `[${getVal('hwB2')}] ` : '') + getVal('hwR2'));
  if (getVal('hwB3') || getVal('hwR3')) hwLines.push((getVal('hwB3') ? `[${getVal('hwB3')}] ` : '') + getVal('hwR3'));
  const hwStr = hwLines.join('\n');

  if (att === '寃곗꽍') {
    return `[${sName} 寃곗꽍 ?덈궡]\n湲덉씪 ?섏뾽??${sName} ?숈깮??李몄꽍?섏? ?딆븯?듬땲??\n寃곗꽍 ?ъ쑀: ${getVal('memo') || '誘멸린??}`;
  }

  // ?뮕 [?듭떖 ?섏젙] 怨듯넻 吏꾨룄瑜?'醫낇빀?덈궡(memo)' ?댁슜怨??꾩븘?섎줈 ?먯뿰?ㅻ읇寃??⑹묩?덈떎!
  let combinedMemo = '';
  if (commonProgress) combinedMemo += commonProgress + '\n';
  if (getVal('memo')) combinedMemo += getVal('memo');
  combinedMemo = combinedMemo.trim(); // ?뱀떆 紐⑤? ?욌뮘 怨듬갚 ?쒓굅

  const templateIdx = document.getElementById(`template_${idx}`)?.value;
  let text = '';
  const firstName = sName.length >= 3 ? sName.substring(1) : sName;
  const isBatchim = (firstName.charCodeAt(firstName.length - 1) - 0xAC00) % 28 > 0;
  const nameYi = isBatchim ? `${firstName}?? : firstName;

  if (templateIdx !== undefined && templateIdx !== '' && appCache.templates[templateIdx]) {
    text = appCache.templates[templateIdx].content;
    text = text.replace(/\{?숈깮?대쫫\}/g, nameYi);
    text = text.replace(/\{媛뺤궗?대쫫\}/g, teacher);
    text = text.replace(/\{?좎쭨\}/g, dateStr);
    text = text.replace(/\{?ㅻ뒛吏꾨룄\}/g, prog ? prog.replace(/\n/g, ', ') : '?놁쓬');
    text = text.replace(/\{?ㅼ쓬怨쇱젣\}/g, hwStr ? hwStr.replace(/\n/g, ', ') : '?놁쓬');
    text = text.replace(/\{?뚯뒪?몄쥌瑜?}/g, getVal('t1Type') || '?쇱씪');
    text = text.replace(/\{留욎?媛쒖닔\}/g, getVal('t1Cor') || '-');
    text = text.replace(/\{?꾩껜媛쒖닔\}/g, getVal('t1Tot') || '-');
    text = text.replace(/\{媛쒕퀎?숈뒿\}/g, getVal('indivLearning') || '');
    text = text.replace(/\{怨쇱젣?쇰뱶諛?}/g, getVal('hwFeedback') || '');
    // ?뮕 ?쒗뵆由우쓽 {醫낇빀?덈궡} ?꾩튂??怨듯넻吏꾨룄+硫붾え ?⑹튇 ?댁슜???ъ엯!
    text = text.replace(/\{醫낇빀?덈궡\}/g, combinedMemo);
    text = text.replace(/\{?덇탳??}/g, getVal('newBook') ? `${getVal('newBook')} (${getVal('bookFee') || '0'}??` : '');
    text = text.replace(/\{移?갔\}/g, getVal('praise') || '');
    text = text.replace(/\{?몃젰\}/g, getVal('effort') || '');
    text = text.replace(/\{遺紐⑤떂猿?}/g, getVal('parentsNote') || '');
    text = text.replace(/\{?됱궗?덈궡\}/g, getVal('eventNotice') || '');
    text = text.replace(/\{?뚯뒪?명뵾?쒕갚\}/g, getVal('testFeedback') || '');
  } else {
    // 湲곕낯 異붿쿇 ?쒗뵆由?
    const nameYiNeun = isBatchim ? `${firstName}?대뒗` : `${firstName}??;
    text = `?덈뀞?섏꽭?? ?섑븰?????뮋${nameYi} ?댁엫 ${teacher}?낅땲???Ⅰ\n${dateStr} ?섏뾽?댁슜 諛??덈궡?ы빆?낅땲??\n\n`;

    let t1Str = (getVal('t1Tot') || getVal('t1Cor')) ? `${getVal('t1Type') || '?쇱씪'} ?뚯뒪??${getVal('t1Tot') || '0'}臾몄젣 以?${getVal('t1Cor') || '0'}臾몄젣` : '';
    let t2Str = (getVal('t2Tot') || getVal('t2Cor')) ? `${getVal('t2Type') && getVal('t2Type') !== getVal('t1Type') ? getVal('t2Type') : '異붽?'} ?뚯뒪??${getVal('t2Tot') || '0'}臾몄젣 以?${getVal('t2Cor') || '0'}臾몄젣` : '';

    const testFb = getVal('testFeedback') ? ` ${getVal('testFeedback')}` : '';

    if (t1Str && t2Str) text += `?뮋?곕━ ${nameYiNeun} ${t1Str}, ${t2Str}瑜?留욏삍?듬땲???삃${testFb}\n\n`;
    else if (t1Str) text += `?뮋?곕━ ${nameYiNeun} ${t1Str}瑜?留욏삍?듬땲???삃${testFb}\n\n`;
    else if (t2Str) text += `?뮋?곕━ ${nameYiNeun} ${t2Str}瑜?留욏삍?듬땲???삃${testFb}\n\n`;

    let comments = [];
    if (commonProgress) comments.push(commonProgress); // ?뮕 醫낇빀?덈궡(memo) 諛붾줈 ?꾩뿉 怨듯넻吏꾨룄 臾몄옣 異붽?
    if (getVal('indivLearning')) comments.push(getVal('indivLearning'));
    if (getVal('memo')) comments.push(getVal('memo'));
    if (comments.length > 0) text += `${comments.join('\n')}\n\n`;

    if (getVal('newBook')) text += `?뱴 ??援먯옱 ?뚮┝\n${getVal('newBook').includes('吏湲?') ? getVal('newBook') : `${getVal('newBook')} (${dateStr.replace('??', '/').replace('??, '')} 吏湲?`} / ${getVal('bookFee') || '0'}??n\n`;

    if (prog) text += `?뱰 吏꾨룄\n${prog}\n\n`;
    if (hwStr) {
      text += `?뱷 ?숈젣 (${hwStatus})\n${hwStr}\n`;
      if (getVal('hwFeedback')) text += `?몛 怨쇱젣 ?쇰뱶諛? ${getVal('hwFeedback')}\n`;
      text += `\n`;
    }

    if (t1Str) text += `?몛 ${getVal('t1Type') || '?쇱씪'} ?뚯뒪??寃곌낵\n${getVal('t1Cor') || '0'}臾몄젣 / ${getVal('t1Tot') || '0'}臾몄젣\n\n`;
    if (t2Str) text += `?몛 ${getVal('t2Type') && getVal('t2Type') !== getVal('t1Type') ? getVal('t2Type') : '異붽?'} ?뚯뒪??寃곌낵\n${getVal('t2Cor') || '0'}臾몄젣 / ${getVal('t2Tot') || '0'}臾몄젣\n\n`;

    if (getVal('praise')) text += `?몟 移?갔????n${getVal('praise')}\n\n`;
    if (getVal('effort')) text += `?뮞 ?몃젰????n${getVal('effort')}\n\n`;
    if (getVal('parentsNote')) text += `?뱼 遺紐⑤떂 ?쒕━??留먯?\n${getVal('parentsNote')}\n\n`;
    if (getVal('eventNotice')) text += `?럦 ?됱궗 ?덈궡\n${getVal('eventNotice')}\n\n`;

    text += `?뙂 ?꾩씠?ㅼ쓽 ?섑븰 ?ㅻ젰 ?μ긽??理쒖꽑???ㅽ븯???섑븰???섏씠 ?섍쿋?듬땲???Ⅰ`;
  }
  return text;
};

window.updateLivePreview = function (idx) {
  const panel = document.getElementById('livePreviewPanel');
  const btn = document.getElementById('previewToggleBtn');
  if (!panel || !btn) return;
  const text = window.generateAlimtalkText(idx);
  if (!text) return;
  document.getElementById('livePreviewContent').textContent = text;
  if (window.isPreviewOpen !== false) {
    panel.style.display = 'block';
    panel.style.opacity = '1';
    btn.style.display = 'none';
  }
};

// =================================================================
// ?? 異쒓껐 紐⑤떖李??닿린 (肄붿뼱 ?붿쭊 ?묒옱 - ?쒕젅???쒓굅)
// =================================================================
window.openAttendanceModal = function (eventId) {
  currentEventForModal = allEvents.find(e => e.id === eventId);
  if (!currentEventForModal) return;

  let modalEl = document.getElementById('attendanceModal');
  if (!modalEl) return console.error("attendanceModal??李얠쓣 ???놁뒿?덈떎.");

  const openDateStr = currentEventForModal.date || new Date().toISOString().substring(0, 10);
  document.getElementById('checkDate').value = openDateStr;
  if (document.getElementById('classProgress')) document.getElementById('classProgress').value = currentEventForModal.commonProgress || "";
  document.getElementById('modalClassInfo').innerText = `${currentEventForModal.day}?붿씪 ${currentEventForModal.timeStr}`;

  const globalBookListEl = document.getElementById('globalBookList');
  if (globalBookListEl) {
    const books = (appCache.raw && appCache.raw.books) || [];
    globalBookListEl.innerHTML = books.map(b => `<option value="${b[0] || ''}">`).join('');
  }

  let listHtml = '';
  let navHtml = '';

  (currentEventForModal.students || []).forEach((s, idx) => {
    let rawBadge = s.badge || "?대쫫?놁쓬";
    let rec = s.record || {};

    let pastRecord = null;
    const attArr = appCache.raw.attendance || [];
    for (let i = attArr.length - 1; i >= 1; i--) {
      const a = attArr[i];
      if ((a[1] === s.id || a[2] === s.name) && a[5] !== undefined && (a[3] || '').substring(0, 10) < openDateStr) {
        pastRecord = a;
        break;
      }
    }

    function getVal(key) { return rec[key] || ''; }
    function getPh(index, defaultTxt) { return (pastRecord && pastRecord[index]) ? `(?댁쟾) ${pastRecord[index]}` : defaultTxt; }

    // ?뮕 [?섏젙] || ?곕젅湲곌컪??嫄몃윭?닿퀬 源붾걫?섍쾶 (?댁쟾) ?쒖떆留??꾩썙以띾땲??
    let pastPR = (pastRecord && pastRecord[8]) ? pastRecord[8].replace(/\(?댁쟾\)\s*/g, '').split('|') : [];
    let pastHwR = (pastRecord && pastRecord[10]) ? pastRecord[10].replace(/\(?댁쟾\)\s*/g, '').split('|') : [];

    function getPhVal(arr, arrIdx, defaultTxt) {
      if (arr && arr[arrIdx]) {
        let val = arr[arrIdx].trim();
        if (val && val !== '|' && val !== '||') return `(?댁쟾) ${val}`;
      }
      return defaultTxt;
    }

    let isAtt = rec.att === '異쒖꽍' ? 'checked' : '';
    let isLate = rec.att === '吏媛? ? 'checked' : '';
    let isAbs = rec.att === '寃곗꽍' ? 'checked' : '';
    let isHwO = rec.hw === '?꾨즺' ? 'checked' : '';
    let isHwM = rec.hw === '誘명씉' ? 'checked' : '';
    let isHwX = rec.hw === '誘몄젣異? ? 'checked' : '';

    let pB = (rec.pBook || (pastRecord ? pastRecord[7] : '') || "").split('|');
    let hwB = (rec.hwBook || (pastRecord ? pastRecord[9] : '') || "").split('|');
    let pR = getVal('pRange').split('|');
    let hwR = getVal('hwRange').split('|');

    let t1Type = rec.t1Type || '?쇱씪'; let t1Cor = getVal('t1Cor'); let t1Tot = getVal('t1Tot'); let t1TotPh = getPh(13, '珥앸Ц??);
    let t2Type = rec.t2Type || '?쇱씪'; let t2Cor = getVal('t2Cor'); let t2Tot = getVal('t2Tot'); let t2TotPh = getPh(16, '珥앸Ц??);

    let color = s.level === '蹂닿컯' ? 'bg-warning text-dark border-warning' : (s.level === '怨? ? 'bg-danger text-white' : (s.level === '以? ? 'bg-primary text-white' : 'bg-success text-white'));
    let displayNameHtml = `<span class="badge ${color} me-2">${s.level}</span>${rawBadge}`;

    navHtml += `<a href="#student-section-${idx}" class="list-group-item list-group-item-action py-3 ${idx === 0 ? 'active' : ''}"><span class="badge ${color} me-1">${s.level}</span> <span class="fw-bold">${rawBadge}</span></a>`;

    const savedTemplate = localStorage.getItem(`template_${openDateStr}_${s.id}`) || '';
    let templateOptions = `<option value="" ${savedTemplate === '' ? 'selected' : ''}>?뮋 湲곕낯 ?쒗뵆由?(異붿쿇)</option>`;
    if (appCache.templates && appCache.templates.length > 0) {
      appCache.templates.forEach((t, tIdx) => {
        templateOptions += `<option value="${tIdx}" ${savedTemplate === String(tIdx) ? 'selected' : ''}>[?쒗듃] ${t.title}</option>`;
      });
    }

    listHtml += `
        <div id="student-section-${idx}" class="p-4 mb-4 bg-white border rounded shadow-sm student-row" data-id="${s.id}" data-name="${s.name}" data-rawbadge="${rawBadge}">
            <div class="row align-items-center mb-3 pb-3 border-bottom">
                <div class="col-md-3 fs-5 fw-bold text-dark d-flex flex-column align-items-start justify-content-center">
                    <div class="d-flex align-items-center mb-2">${displayNameHtml}</div>
                    <div class="d-flex gap-1 w-100 mb-2">
                        <button type="button" class="btn btn-sm btn-outline-warning fw-bold flex-fill" style="font-size: 0.65rem;" onclick="saveAttendance('?꾩떆???, false, ${idx})">?꾩떆????뮶</button>
                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold flex-fill" style="font-size: 0.65rem;" onclick="saveAttendance('理쒖쥌?쒖텧', false, ${idx})">理쒖쥌?쒖텧 ??</button>
                    </div>
                    <div class="d-flex gap-1 w-100">
                        <select class="form-select form-select-sm border-info fw-bold text-info flex-grow-1" id="template_${idx}" onchange="if(window.updateLivePreview) window.updateLivePreview('${idx}')" style="font-size: 0.75rem;">
                            ${templateOptions}
                        </select>
                        <button type="button" class="btn btn-sm btn-outline-info" onclick="editSelectedTemplate('${idx}')" title="?좏깮???쒗뵆由??섏젙"><i class="bi bi-gear-fill"></i></button>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="small fw-bold text-secondary mb-1">異쒓껐 ?곹깭</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="att_${idx}" id="att_o_${idx}" value="異쒖꽍" ${isAtt} onchange="onAttChange(this)">
                        <label class="btn btn-outline-success btn-sm" for="att_o_${idx}">異쒖꽍</label>
                        <input type="radio" class="btn-check" name="att_${idx}" id="att_l_${idx}" value="吏媛? ${isLate} onchange="onAttChange(this)">
                        <label class="btn btn-outline-warning btn-sm" for="att_l_${idx}">吏媛?/label>
                        <input type="radio" class="btn-check" name="att_${idx}" id="att_x_${idx}" value="寃곗꽍" ${isAbs} onchange="onAttChange(this)">
                        <label class="btn btn-outline-danger btn-sm" for="att_x_${idx}">寃곗꽍</label>
                    </div>
                </div>
                <div class="col-md-5">
                    <label class="small fw-bold text-secondary mb-1">怨쇱젣 ?섑뻾</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="hw_${idx}" id="hw_o_${idx}" value="?꾨즺" ${isHwO}>
                        <label class="btn btn-outline-primary btn-sm" for="hw_o_${idx}">?꾨즺</label>
                        <input type="radio" class="btn-check" name="hw_${idx}" id="hw_m_${idx}" value="誘명씉" ${isHwM}>
                        <label class="btn btn-outline-secondary btn-sm" for="hw_m_${idx}">誘명씉</label>
                        <input type="radio" class="btn-check" name="hw_${idx}" id="hw_x_${idx}" value="誘몄젣異? ${isHwX}>
                        <label class="btn btn-outline-danger btn-sm" for="hw_x_${idx}">誘몄젣異?/label>
                    </div>
                </div>
            </div>
            <div class="row g-3 bg-light p-3 rounded border border-light mb-3">
                <div class="col-md-6 border-end">
                    <label class="small fw-bold text-primary mb-2"><i class="bi bi-book"></i> ?ㅻ뒛 吏꾨룄</label>
                    <div class="input-group input-group-sm mb-2 shadow-sm"><input type="text" class="form-control bg-white" id="pB1_${idx}" list="globalBookList" placeholder="吏꾨룄援먯옱 1" value="${pB[0] || ''}"><input type="text" class="form-control bg-white" id="pR1_${idx}" placeholder="${getPhVal(pastPR, 0, '踰붿쐞')}" value="${pR[0] || ''}"></div>
                    <div class="input-group input-group-sm shadow-sm"><input type="text" class="form-control bg-white" id="pB2_${idx}" list="globalBookList" placeholder="吏꾨룄援먯옱 2" value="${pB[1] || ''}"><input type="text" class="form-control bg-white" id="pR2_${idx}" placeholder="${getPhVal(pastPR, 1, '踰붿쐞')}" value="${pR[1] || ''}"></div>
                    <div class="input-group input-group-sm shadow-sm mt-2"><input type="text" class="form-control bg-white" id="pB3_${idx}" list="globalBookList" placeholder="吏꾨룄援먯옱 3" value="${pB[2] || ''}"><input type="text" class="form-control bg-white" id="pR3_${idx}" placeholder="${getPhVal(pastPR, 2, '踰붿쐞')}" value="${pR[2] || ''}"></div>
                </div>
                <div class="col-md-6">
                    <label class="small fw-bold text-success mb-2"><i class="bi bi-pencil-square"></i> ?ㅼ쓬 怨쇱젣</label>
                    <div class="input-group input-group-sm mb-2 shadow-sm"><input type="text" class="form-control bg-white" id="hwB1_${idx}" list="globalBookList" placeholder="怨쇱젣援먯옱 1" value="${hwB[0] || ''}"><input type="text" class="form-control bg-white" id="hwR1_${idx}" placeholder="${getPhVal(pastHwR, 0, '踰붿쐞')}" value="${hwR[0] || ''}"></div>
                    <div class="input-group input-group-sm mb-2 shadow-sm"><input type="text" class="form-control bg-white" id="hwB2_${idx}" list="globalBookList" placeholder="怨쇱젣援먯옱 2" value="${hwB[1] || ''}"><input type="text" class="form-control bg-white" id="hwR2_${idx}" placeholder="${getPhVal(pastHwR, 1, '踰붿쐞')}" value="${hwR[1] || ''}"></div>
                    <div class="input-group input-group-sm shadow-sm"><input type="text" class="form-control bg-white" id="hwB3_${idx}" list="globalBookList" placeholder="怨쇱젣援먯옱 3" value="${hwB[2] || ''}"><input type="text" class="form-control bg-white" id="hwR3_${idx}" placeholder="${getPhVal(pastHwR, 2, '踰붿쐞')}" value="${hwR[2] || ''}"></div>
                </div>
            </div>
            
            <div class="row g-2 align-items-center mb-2">
                <div class="col-md-2"><span class="badge bg-danger w-100 py-2">?뚯뒪??1</span></div>
                <div class="col-md-3"><select class="form-select form-select-sm" id="t1Type_${idx}"><option value="?쇱씪" ${t1Type === '?쇱씪' ? 'selected' : ''}>?쇱씪 ?뚯뒪??/option><option value="二쇨컙" ${t1Type === '二쇨컙' ? 'selected' : ''}>二쇨컙 ?뚯뒪??/option><option value="?붽컙" ${t1Type === '?붽컙' ? 'selected' : ''}>?붽컙 ?됯?</option></select></div>
                <div class="col-md-4 d-flex align-items-center gap-2"><input type="number" class="form-control form-control-sm text-center fw-bold" id="t1Cor_${idx}" placeholder="?뺣떟" value="${t1Cor}"><span class="fw-bold text-muted">/</span><input type="number" class="form-control form-control-sm text-center text-muted" id="t1Tot_${idx}" placeholder="${t1TotPh}" value="${t1Tot}"></div>
            </div>
            <div class="row g-2 align-items-center mb-2">
                <div class="col-md-2"><span class="badge bg-primary text-white w-100 py-2">?뚯뒪??2</span></div>
                <div class="col-md-3"><select class="form-select form-select-sm" id="t2Type_${idx}"><option value="?쇱씪" ${t2Type === '?쇱씪' ? 'selected' : ''}>?쇱씪 ?뚯뒪??/option><option value="二쇨컙" ${t2Type === '二쇨컙' ? 'selected' : ''}>二쇨컙 ?뚯뒪??/option><option value="?붽컙" ${t2Type === '?붽컙' ? 'selected' : ''}>?붽컙 ?됯?</option></select></div>
                <div class="col-md-4 d-flex align-items-center gap-2"><input type="number" class="form-control form-control-sm text-center fw-bold" id="t2Cor_${idx}" placeholder="?뺣떟" value="${t2Cor}"><span class="fw-bold text-muted">/</span><input type="number" class="form-control form-control-sm text-center text-muted" id="t2Tot_${idx}" placeholder="${t2TotPh}" value="${t2Tot}"></div>
            </div>
            
            <div class="row g-2 align-items-center mb-3 mt-2">
                <div class="col-md-2"><span class="badge bg-secondary text-white w-100 py-2">?뚯뒪???쇰뱶諛?/span></div>
                <div class="col-md-10"><input type="text" class="form-control form-control-sm border-secondary" id="testFeedback_${idx}" placeholder="?뚯뒪??寃곌낵 肄붾찘?몃? ?곸뼱二쇱꽭??(?뚮┝?≪쓽 '留욏삍?듬땲?? ?ㅼ뿉 ?먯뿰?ㅻ읇寃??댁뼱吏묐땲??" value="${getVal('testFeedback')}"></div>
            </div>

            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-2"><span class="badge bg-info text-dark w-100 py-2">??援먯옱 泥?뎄</span></div>
                <div class="col-md-5"><input type="text" class="form-control form-control-sm border-info" id="newBook_${idx}" list="globalBookList" placeholder="諛쒓툒??援먯옱紐?寃??.." value="${getVal('newBook')}" onchange="if(window.updateBookFee) window.updateBookFee('${idx}')" onkeyup="if(window.updateBookFee) window.updateBookFee('${idx}')" oninput="if(window.updateBookFee) window.updateBookFee('${idx}')"></div>
                <div class="col-md-3 d-flex align-items-center gap-2"><input type="number" class="form-control form-control-sm text-end" id="bookFee_${idx}" placeholder="湲덉븸(??" value="${getVal('bookFee')}"><span class="small text-muted fw-bold">??/span></div>
            </div>
            <div class="row g-2 mb-2 mt-3">
                <div class="col-md-6"><div class="input-group input-group-sm"><span class="input-group-text bg-light border-primary text-primary fw-bold">媛쒕퀎?숈뒿</span><input type="text" class="form-control border-primary" id="indivLearning_${idx}" placeholder="${getPh(26, '?ㅻ뒛 ?숈뒿???뱀씠?ы빆')}" value="${getVal('indivLearning')}"></div></div>
                <div class="col-md-6"><div class="input-group input-group-sm"><span class="input-group-text bg-light border-danger text-danger fw-bold">怨쇱젣?쇰뱶諛?/span><input type="text" class="form-control border-danger" id="hwFeedback_${idx}" placeholder="${getPh(22, '怨쇱젣 ?섑뻾 肄붾찘??)}" value="${getVal('hwFeedback')}"></div></div>
            </div>
            
            <div class="row g-2 mb-2">
              <div class="col-12">
                <textarea class="form-control bg-light" placeholder="${getPh(17, '?뮠 醫낇빀?덈궡')}" id="memo_${idx}" rows="2">${getVal('memo')}</textarea>
              </div>
            </div>
            
            <div class="row g-2 mb-2">
                <div class="col-md-4"><input type="text" class="form-control form-control-sm bg-light" id="praise_${idx}" placeholder="${getPh(23, '?몟 移?갔????)}" value="${getVal('praise')}"></div>
                <div class="col-md-4"><input type="text" class="form-control form-control-sm bg-light" id="effort_${idx}" placeholder="${getPh(24, '?뮞 ?몃젰????)}" value="${getVal('effort')}"></div>
                <div class="col-md-4"><input type="text" class="form-control form-control-sm bg-light" id="parentsNote_${idx}" placeholder="${getPh(25, '?뱼 遺紐⑤떂猿?)}" value="${getVal('parentsNote')}"></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><input type="text" class="form-control form-control-sm bg-light text-primary fw-bold" id="eventNotice_${idx}" placeholder="${getPh(27, '?럦 ?됱궗 ?덈궡')}" value="${getVal('eventNotice')}"></div>
                <div class="col-md-6"><input type="text" class="form-control form-control-sm border-secondary bg-secondary bg-opacity-10" id="privateMemo_${idx}" placeholder="?뵏 鍮꾨? 硫붾え" value="${getVal('privateMemo')}"></div>
            </div>
        </div>`;
  });

  document.getElementById('studentNavList').innerHTML = navHtml;
  document.getElementById('studentCheckList').innerHTML = listHtml;

  let modal = new bootstrap.Modal(modalEl);
  modal.show();

  setTimeout(() => {
    const navLinks = document.querySelectorAll('#studentNavList a');
    const scrollContainer = document.getElementById('studentCheckList');

    scrollContainer.addEventListener('input', function (e) {
      const row = e.target.closest('.student-row');
      if (row && window.updateLivePreview) window.updateLivePreview(row.id.replace('student-section-', ''));
    });
    scrollContainer.addEventListener('change', function (e) {
      const row = e.target.closest('.student-row');
      if (row && window.updateLivePreview) window.updateLivePreview(row.id.replace('student-section-', ''));
    });

    const classProgressEl = document.getElementById('classProgress');
    if (classProgressEl) {
      classProgressEl.addEventListener('input', function () {
        const rows = document.querySelectorAll('.student-row');
        rows.forEach((row, DOMidx) => {
          if (window.updateLivePreview) window.updateLivePreview(DOMidx);
        });
      });
    }

    navLinks.forEach(link => {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        navLinks.forEach(l => l.classList.remove('active'));
        this.classList.add('active');
        const targetId = this.getAttribute('href').substring(1);
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          scrollContainer.scrollTo({ top: targetEl.offsetTop - scrollContainer.offsetTop, behavior: 'smooth' });
          if (window.updateLivePreview) window.updateLivePreview(targetId.replace('student-section-', ''));
        }
      });
    });
  }, 300);
};

window.updateBookFee = function (idx) {
  const bookNameInput = document.getElementById('newBook_' + idx);
  const bookFeeInput = document.getElementById('bookFee_' + idx);
  if (!bookNameInput || !bookFeeInput) return;
  const typedName = bookNameInput.value.trim();
  if (!typedName) { bookFeeInput.value = ''; return; }
  const books = (appCache.raw && appCache.raw.books) || [];
  const foundBook = books.find(b => b[0] === typedName);
  if (foundBook && foundBook[2]) {
    bookFeeInput.value = foundBook[2].toString().replace(/[^0-9]/g, '');
  } else {
    bookFeeInput.value = '';
  }
};

window.onAttChange = function (sel) {
  const card = sel.closest('.student-row');
  if (!card) return;
  const isAbsent = (sel.value === '寃곗꽍');
  const idx = card.id.replace('student-section-', '');

  card.querySelectorAll('input[type="radio"][name^="hw_"], input[type="text"]:not(#memo_' + idx + '), input[type="number"], textarea:not(#memo_' + idx + '), select:not(#template_' + idx + ')').forEach(el => { el.disabled = isAbsent; });

  const memoEl = document.getElementById('memo_' + idx);
  if (memoEl) {
    memoEl.disabled = false;
    if (isAbsent) {
      memoEl.placeholder = "?슚 寃곗꽍 ?ъ쑀瑜??곸꽭???곸뼱二쇱꽭??(???댁슜??蹂닿컯 愿由щ줈 ?섏뼱媛묐땲??";
      memoEl.classList.add('border-danger', 'border-2');
      memoEl.classList.remove('bg-light');
    } else {
      memoEl.placeholder = "?뮠 醫낇빀?덈궡";
      memoEl.classList.remove('border-danger', 'border-2');
      memoEl.classList.add('bg-light');
    }
  }

  const detailAreas = card.querySelectorAll('.bg-light, .row.g-2');
  detailAreas.forEach(area => {
    if (!area.contains(memoEl)) {
      area.style.opacity = isAbsent ? '0.4' : '1';
    } else {
      area.style.opacity = '1';
    }
  });

  card.style.borderLeft = isAbsent ? '4px solid #ef4444' : '4px solid #3b82f6';
};
